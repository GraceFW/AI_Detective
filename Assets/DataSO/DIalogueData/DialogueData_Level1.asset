      dialogueText: "\u6240\u6709\u7684\u68C0\u9A8C\u4EBA\u5458\u90FD\u8BA4\u4E3A\u4F60\u7684\u63A8\u7406\u6CA1\u6709\u4EFB\u4F55\u95EE\u9898\uFF0C\u68C0\u65B9\u5DF2\u5BF9\u51AC\u9A6C\u88D5\u4ECB\u6B63\u5F0F\u63D0\u8D77\u516C\u8BC9\u3002\u5F53\u7136\uFF0C\u4F60\u770B\u8D77\u6765\u4E5F\u4E0D\u6B62\u627E\u5230\u4E86\u4E00\u4E2A\u771F\u76F8\u2014\u2014\u4F60\u63D0\u4EA4\u7684\u8F85\u52A9\u8C03\u67E5\u5185\u5BB9\u5BF9\u4E8E\u8BC4\u4F30\u6848\u5B50\u6709\u5F88\u5927\u5E2E\u52A9\u3002"
