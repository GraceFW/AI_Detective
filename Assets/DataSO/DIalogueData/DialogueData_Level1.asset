    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u77E5\u9053\u4ECA\u5929\u662F\u4EC0\u4E48\u65E5\u5B50\u5417\uFF0C\u5DE5\u85E4\u3002"
