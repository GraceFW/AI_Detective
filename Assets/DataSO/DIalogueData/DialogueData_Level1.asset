      customActionArgument: 
    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u5DE5\u85E4\u65B0\u4E00\u3002\u4F60\u7684\u5B58\u5728\uFF0C\u662F\u5212\u65F6\u4EE3\u7684\u3002"
