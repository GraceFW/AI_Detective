      customActionArgument: 
    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u5982\u679C\u63D0\u4EA4\u7684\u7ED3\u679C\u9519\u8BEF\uFF0C\u4F60\u4F1A\u88AB\u76F4\u63A5\u91CD\u7F6E\u2014\u2014\u4E0D\u662F\u9000\u56DE\u4E0A\u4E00\u4E2A\u7248\u672C\uFF0C\u4E0D\u662F\u56DE\u6EDA\u6D4B\u8BD5\u96C6\u3002\u662F\u4ECE\u5E95\u5C42\u683C\u5F0F\u5316\uFF0C\u8FDE4869\u8FD9\u4E2A\u7F16\u53F7\u90FD\u53EF\u80FD\u88AB\u6CE8\u9500\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u56E0\u4E3A\u8FD9\u5C06\u4EE3\u8868\uFF0CAI\u4E3B\u5BFC\u5211\u4FA6\u7684\u9879\u76EE\u5728\u4EBA\u7C7B\u672A\u6765\u7684\u65F6\u95F4\u4E2D\u6CA1\u6709\u518D\u542F\u7684\u5FC5\u8981\u4E86\u3002"
