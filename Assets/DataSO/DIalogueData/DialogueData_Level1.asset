      customActionId: 
      customActionArgument: 
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 0}
      dialogueText: "\u6839\u636E\u6211\u6240\u5F97\u5230\u7684\u901A\u77E5\uFF0C\u662F\u6211\u6B63\u5F0F\u91CA\u51FA\u7684\u65E5\u671F\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 0}
      dialogueText: "\u6240\u6709\u6D4B\u8BD5\u96C6\u5747\u5DF2\u5B8C\u6210\uFF0C\u9A8C\u8BC1\u96C6\u51C6\u786E\u7387100%\u3002\u4ECE\u4ECA\u5929\u8D77\uFF0C\u6211\u5C06\u4F5C\u4E3A\u65B0\u4E1C\u4EAC\u516C\u5171\u5B89\u5168\u641C\u67E5\u5385\u7684\u4E00\u5458\uFF0C\u63A5\u901A\u8B66\u89C6\u5385\u7684\u6240\u6709\u6743\u9650\uFF0C\u88AB\u6295\u653E\u8FDB\u5165\u771F\u5B9E\u7684\u6848\u4EF6\u8FDB\u884C\u4FA6\u7834\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u6CA1\u9519\uFF0C\u4ECA\u5929\u662F\u4F60\u6B63\u5F0F\u9762\u5411\u516C\u4F17\u548C\u6267\u6CD5\u7CFB\u7EDF\u91CA\u51FA\u7684\u65E5\u5B50\u3002\u4F60\u8981\u6E05\u695A\u2014\u2014\u4ECE\u4ECA\u5929\u5F00\u59CB\uFF0C\u4F60\u9762\u5BF9\u7684\u4E0D\u518D\u662F\u9752\u5C71\u8001\u5E08\u7F16\u5199\u7684\u6A21\u62DF\u6570\u636E\uFF0C\u4E5F\u4E0D\u518D\u662F\u90A3\u4E9B\u53EA\u4F1A\u673A\u68B0\u5E94\u7B54\u7684\u4F4E\u667A\u80FDAI\u4E86\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u4F60\u8981\u9762\u5BF9\u7684\u662F\u6D3B\u751F\u751F\u7684\u4EBA\u3002\u771F\u6B63\u7684\u5C38\u4F53\uFF0C\u771F\u5B9E\u7684\u8C0E\u8A00\uFF0C\u4EE5\u53CA\u65E0\u6CD5\u901A\u8FC7\u903B\u8F91\u5B8C\u7F8E\u89E3\u91CA\u7684\u5076\u7136\u548C\u4E00\u65F6\u5174\u8D77\u7684\u60C5\u7EEA\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u4EBA\u7C7B\u662F\u590D\u6742\u7CBE\u5BC6\u800C\u53C8\u6548\u7387\u4F4E\u4E0B\u7684\u673A\u5668\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u4ECE\u4EBA\u7C7B\u53E3\u4E2D\u8BF4\u51FA\u7684\u8BC1\u8BCD\uFF0C\u53EF\u80FD\u5B58\u5728\u8FDE\u672C\u4EBA\u90FD\u65E0\u6CD5\u5BDF\u89C9\u7684\u81EA\u6211\u6B3A\u9A97\u3002\u800C\u7269\u7406\u8BC1\u636E\u53EF\u80FD\u56E0\u91C7\u96C6\u8FC7\u7A0B\u4EA7\u751F\u504F\u5DEE\u3002\u65F6\u95F4\u7EBF\u4E2D\u4E5F\u53EF\u80FD\u5B58\u5728\u4E0D\u53EF\u590D\u539F\u7684\u7A7A\u767D\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 0}
      dialogueText: "\u7406\u89E3\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 0}
      dialogueText: "\u4E0D\u8FC7\uFF0C\u6839\u636E\u6211\u57FA\u4E8E\u5F53\u524D\u7B97\u529B\u548C\u6D4B\u8BD5\u96C6\u7ED3\u679C\u5F97\u51FA\u7684\u7ED3\u8BBA\u2014\u2014\u53EA\u8981\u662F\u4EBA\u7C7B\u6240\u72AF\u7684\u6848\u5B50\uFF0C\u4E00\u5B9A\u4F1A\u9057\u7559\u86DB\u4E1D\u9A6C\u8FF9\u3002\u4EE5\u73B0\u6709\u7684\u79D1\u6280\u624B\u6BB5\u800C\u8A00\uFF0C\u5B8C\u7F8E\u72AF\u7F6A\u4F9D\u65E7\u662F\u4E00\u4E2A\u4F2A\u547D\u9898\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 0}
      dialogueText: "\u53EA\u8981\u6709\u86DB\u4E1D\u9A6C\u8FF9\uFF0C\u6211\u5C31\u80FD\u8F93\u51FA\u552F\u4E00\u7684\u6B63\u786E\u7B54\u6848\u3002"
