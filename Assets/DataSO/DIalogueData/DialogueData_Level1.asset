      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u4F60\u662F\u5168\u65E5\u672C\uFF0C\u4E43\u81F3\u5168\u4E16\u754C\u7B2C\u4E00\u4E2A\u771F\u6B63\u6295\u5165\u5B9E\u6218\u7684\u53F8\u6CD5\u5211\u4FA6AI\u3002\u4F60\u7684\u4E00\u4E3E\u4E00\u52A8\uFF0C\u6BCF\u4E00\u4EFD\u63A8\u7406\u62A5\u544A\uFF0C\u6BCF\u4E00\u4E2A\u7ED3\u8BBA\uFF0C\u90FD\u4EE3\u8868\u7740\u65B0\u4E1C\u4EAC\u516C\u5171\u5B89\u5168\u641C\u67E5\u5385\u7684\u6280\u672F\u5E95\u7EBF\uFF0C\u4E5F\u4EE3\u8868\u7740\u201CAI\u80FD\u5426\u66FF\u4EE3\u4EBA\u7C7B\u5BA1\u5224\u4EBA\u7C7B\u201D\u8FD9\u4E2A\u95EE\u9898\u7684\u6700\u7EC8\u7B54\u6848\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u4E0A\u9762\u6709\u5F88\u591A\u4EBA\u76EF\u7740\u4F60\u3002\u4E5F\u6709\u5F88\u591A\u4EBA\u5E0C\u671B\u770B\u5230\u4F60\u51FA\u9519\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
    - speakerName: Admin
      speakerImage: {fileID: 0}
      dialogueText: "\u6240\u4EE5\uFF0C\u6211\u5FC5\u987B\u544A\u77E5\u4F60\uFF0C\u5982\u679C\u4F60\u5931\u8D25\u4E86\u2014\u2014\u4F60\u6CA1\u6709\u7B2C\u4E8C\u6B21\u673A\u4F1A\u3002"
