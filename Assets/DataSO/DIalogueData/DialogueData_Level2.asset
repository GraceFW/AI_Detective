      customBgmTrack: {fileID: 0}
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 21300000, guid: 5e5e13c69df3e254cb2614bfa11248a0, type: 3}
      dialogueText: "\u51B5\u4E14\uFF0C\u6240\u6709\u88AB\u62AB\u9732\u7684\u8D44\u6599\uFF0C\u771F\u5B9E\u5EA6\u572898%\u4EE5\u4E0A\uFF0C\u786E\u5B9E\u662F\u6B7B\u8005\u6240\u4E3A\uFF0C\u8FD9\u6837\u7684\u7F6A\u884C\u672C\u4E0D\u5E94\u968F\u7740\u4ED6\u7684\u6B7B\u4EA1\u88AB\u63A9\u76D6\uFF0C\u800C\u88AB\u516C\u5F00\u4F1A\u5F15\u8D77\u6C11\u6124\uFF0C\u4E5F\u662F\u5408\u7406\u7684\u793E\u4F1A\u53CD\u5E94\u3002\u6211\u4EEC\u4E0D\u80FD\u98A0\u5012\u9ED1\u767D\u3002"
      useTypewriterEffect: 1
