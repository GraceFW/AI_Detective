      dialogueText: "\u2026\u2026\u6709\u4EBA\u5165\u4FB5\u4E86\u591A\u5BB6\u5A92\u4F53\u7684\u53D1\u5E03\u540E\u53F0\uFF0C\u4EE5\u53CA\u51E0\u4E2A\u5927\u578B\u533F\u540D\u8BBA\u575B\u7684\u6570\u636E\u5E93\u3002
