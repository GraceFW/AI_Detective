    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 21300000, guid: b93c90acddde90d40984b068b4d75b53, type: 3}
      dialogueText: "\u60A8\u597D\uFF0C\u6211\u662F\u96B6\u5C5E\u4E8E\u65B0\u4E1C\u4EAC\u516C\u5171\u5B89\u5168\u641C\u67E5\u5385\u7684\u53F8\u6CD5\u5211\u4FA6AI\u5DE5\u85E4\u65B0\u4E00\uFF0C\u5F53\u524D\u6570\u636E\u5E93\u7CFB\u7EDF\u5DF2\u68C0\u6D4B\u5230\u65B0\u7684\u6848\u60C5\u3002\u8BF7\u5E2E\u52A9\u6211\u786E\u8BA4\u73B0\u573A\u72B6\u51B5\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u8B66\u5458"
      speakerImage: {fileID: 0}
      dialogueText: "\u554A\u2026\u2026\u662F\u3002\u8FD9\u91CC\u662F\u4E1C\u4EAC\u5DE8\u86CB\u73B0\u573A\u6267\u884C\u7EC4\uFF0C\u89C1\u4E60\u5DE1\u8B66\u4E09\u4E0A\u62D3\u6D77\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 21300000, guid: 5e5e13c69df3e254cb2614bfa11248a0, type: 3}
      dialogueText: "\u4E09\u4E0A\u5DE1\u8B66\uFF0C\u8F9B\u82E6\u4E86\u3002\u8BF7\u7B80\u8FF0\u6848\u4EF6\u6982\u8981\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u8B66\u5458"
      speakerImage: {fileID: 0}
      dialogueText: "\u6848\u53D1\u5730\u70B9\u5728\u4E1C\u4EAC\u5DE8\u86CB\uFF0C\u8FD9\u91CC\u521A\u521A\u7ED3\u675F\u4E86\u4E00\u573A\u5973\u56E2\u5076\u50CF\u7684\u6F14\u5531\u4F1A\u2026\u2026\u6B7B\u8005\u662F\u5076\u50CF\u56E2\u4F53\u201C\u661F\u9022\u201D\u6240\u5C5E\u4E8B\u52A1\u6240\u7684\u9AD8\u7BA1\u3002\u6B7B\u56E0\u521D\u6B65\u5224\u65AD\u4E3A\u4E2D\u6BD2\uFF0C\u5177\u4F53\u8FD8\u5728\u7B49\u6CD5\u533B\u90A3\u8FB9\u51FA\u5177\u5C38\u68C0\u62A5\u544A\u3002\u53D1\u73B0\u65F6\u95F4\u662F\u4ECA\u665A\u665A\u573A\u6F14\u51FA\u7ED3\u675F\u540E\uFF0C\u7531\u4E24\u540D\u827A\u4EBA\u62A5\u7684\u8B66\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u8B66\u5458"
      speakerImage: {fileID: 0}
      dialogueText: "\u56E0\u4E3A\u987E\u8651\u516C\u5173\u5F62\u8C61\uFF0C\u5076\u50CF\u516C\u53F8\u90A3\u8FB9\u975E\u5E38\u7D27\u5F20\u3002\u8981\u6C42\u5728\u5F97\u5230\u786E\u5207\u7684\u771F\u76F8\u4E4B\u524D\uFF0C\u7EDD\u5BF9\u4E0D\u80FD\u5916\u6CC4\u6D88\u606F\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 21300000, guid: 05f4045641d66824890371380873a1b8, type: 3}
      dialogueText: "\u7406\u89E3\uFF0C\u6BD5\u7ADF\u5076\u50CF\u516C\u53F8\u7684\u516C\u4F17\u5F62\u8C61\u4E0E\u5546\u4E1A\u4EF7\u503C\u9AD8\u5EA6\u7ED1\u5B9A\u3002\u6848\u4EF6\u5728\u67E5\u6E05\u4E4B\u524D\uFF0C\u4FE1\u606F\u6269\u6563\u4F1A\u9020\u6210\u4E0D\u53EF\u63A7\u7684\u8206\u8BBA\u98CE\u9669\u2014\u2014\u6211\u4F1A\u5C31\u8FD9\u4E00\u70B9\u5C3D\u529B\u914D\u5408\u4ED6\u4EEC\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u8B66\u5458"
      speakerImage: {fileID: 0}
      dialogueText: "\u5BF9\u5BF9\u5BF9\u2026\u2026\u6240\u4EE5\u6211\u4EEC\u5DF2\u7ECF\u628A\u73B0\u573A\u6240\u6709\u76F8\u5173\u4EBA\u5458\u2014\u2014\u5C24\u5176\u662F\u90A3\u51E0\u4E2A\u5ACC\u7591\u4EBA\u7684\u624B\u673A\u5168\u90E8\u6536\u7F34\u4E86\u3002\u9632\u6B62\u4ED6\u4EEC\u8054\u7CFB\u5916\u754C\u6216\u8005\u5220\u9664\u4EC0\u4E48\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 21300000, guid: 9e0f98eae1493774182f1e870ddcfb65, type: 3}
      dialogueText: "\u597D\u7684\uFF0C\u65E2\u7136\u5982\u6B64\uFF0C\u7D22\u6027\u628A\u90A3\u4E9B\u624B\u673A\u7684\u5B8C\u6574\u6570\u636E\u6743\u9650\u5411\u6211\u5F00\u653E\u3002\u4E0D\u5FC5\u62C5\u5FC3\u6743\u9650\u95EE\u9898\u2014\u2014\u6211\u60F3\u60A8\u4EEC\u90A3\u8FB9\u5E94\u8BE5\u4E5F\u6709\u8FC7\u5BF9\u8FD9\u65B9\u9762\u7684\u57F9\u8BAD\uFF1F"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u8B66\u5458"
