    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 21300000, guid: 05f4045641d66824890371380873a1b8, type: 3}
      dialogueText: "\u9A73\u56DE\u3002\u6240\u6709\u63A8\u7406\u94FE\u8DEF\u5747\u5728\u5185\u90E8\u670D\u52A1\u5668\u5B8C\u6210\uFF0C\u4E0D\u5B58\u5728\u6CC4\u9732\u98CE\u9669\u3002"
