  summary: "\u5C5E\u4E8E\u51AC\u9A6C\u88D5\u4ECB\uFF0C\u559D\u5B8C\u7684\u5496\u5561\u676F\u3002\u7ECF\u8FC7\u9ED1\u5149\u706F\u7167\u5C04\uFF0C\u53D1\u73B0\u676F\u5B50\u5916\u4FA7\u6709\u4E0D\u660E\u663E\u7684\u7529\u6E85\u72B6\u8840\u8FF9\u3002"
  detailText: 
  Detail_Mark: "[\u7ED3\u679C]\uFF1A\u68C0\u9A8C\u62A5\u544A\u5DF2\u751F\u6210\u3002\r\n\r\n\u3010DNA\u5206\u6790\u3011\r\n\u5BF9\u7A7A\u5496\u5561\u676F\u4E0A\u7684\u8840\u6E0D\u8FDB\u884CSTR\u5206\u578B\u68C0\u6D4B\uFF0C\u83B7\u5F97\u5B8C\u6574DNA\u56FE\u8C31\u3002\u5C06\u8BE5\u56FE\u8C31\u4E0E\u6B7B\u8005\u677E\u4E95\u77F3\u6839\u7684\u53E3\u8154\u62ED\u5B50\u6837\u672C\u8FDB\u884C\u6BD4\u5BF9\uFF0C\u5339\u914D\u6982\u7387\u4E3A99.92%\u3002\r\n\r\n\u7ED3\u8BBA\uFF1A\u5496\u5561\u676F\u4E0A\u7684\u8840\u6E0D\u6765\u6E90\u4E8E\u6B7B\u8005\u672C\u4EBA\u3002"
