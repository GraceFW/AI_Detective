  m_Script: {fileID: 11500000, guid: a797a7bbc187b28408d77a69535b4456, type: 3}
  m_Name: "2003\u5C38\u68C0\u62A5\u544A"
  m_EditorClassIdentifier: 
  id: 2003
  displayName: "\u5C38\u68C0\u62A5\u544A"
  detectable: 1
  collectable: 1
  collected: 0
  attackKey: 
  isAttackContentUnlocked: 0
  showAttackContentDirectly: 1
  attackUnlockContent: 
  summary: "\u5B98\u65B9\u6CD5\u533B\u5B66\u62A5\u544A\u3002\u53EF\u4ECE\u6B7B\u8005\u5C38\u4F53\u786E\u8BA4\u8FC7\u654F\u6027\u4F11\u514B\u3001\u6C14\u7BA1\u80BF\u80C0\u5BFC\u81F4\u7684\u7A92\u606F\u4EE5\u53CA\u5FC3\u6E90\u6027\u4F11\u514B\uFF0C\u5FC3\u6E90\u6027\u4F11\u514B\u731D\u6B7B\u4E3A\u76F4\u63A5\u6B7B\u56E0\u3002"
  detailText: 
  Detail_Mark: "[\u7ED3\u679C]\uFF1A\u5DF2\u6388\u6743\uFF08\u6848\u4EF6\u4FA6\u529E\u7F16\u53F7\uFF1A20560815\uFF09\r\n\r\n\u3010\u57FA\u672C\u4FE1\u606F\u3011\r\n\u6765\u6E90\uFF1A
    \u4E1C\u4EAC\u90FD\u76D1\u5BDF\u533B\u52A1\u9662 \xB7 \u7535\u5B50\u6863\u6848\u5E93\r\n\u5C38\u4F53\u6807\u8BC6\uFF1A\u9AD8\u5CF0
    \u8BDA\u4E00\u90CE\uFF08\u7537\uFF0C47\u5C81\uFF09\r\n\u68C0\u9A8C\u7F16\u53F7\uFF1APM-20560815-11\r\n\u62A5\u544A\u72B6\u6001\uFF1A\u521D\u6B65\u68C0\u9A8C\u5B8C\u6210\uFF0C\u6BD2\u7406\u5B66\u62A5\u544A\u5F85\u8865\u5145\u3002\r\n\r\n\u3010\u5C38\u8868\u5F81\u8C61\u3011\r\n\u5C38\u4F53\u88AB\u53D1\u73B0\u65F6\u4F53\u6E29\u63A5\u8FD1\u4EBA\u4F53\u6B63\u5E38\u6E29\u5EA6\uFF0C\u5C38\u6591\u6682\u672A\u51FA\u73B0\uFF0C\u53EF\u4EE5\u786E\u8BA4\u81EA\u6B7B\u4EA1\u81F3\u88AB\u53D1\u73B0\u65F6\u95F4\u6781\u77ED\u3002\r\n\u5168\u8EAB\u808C\u8089\u677E\u5F1B\uFF0C\u672A\u51FA\u73B0\u5C38\u50F5\u3002\u4E0B\u988C\u5173\u8282\u6D3B\u52A8\u81EA\u5982\uFF0C\u56DB\u80A2\u5173\u8282\u65E0\u62B5\u6297\u611F\u3002\u7B26\u5408\u6B7B\u540E\u7684\u65E9\u671F\u8868\u73B0\u3002\r\n\u4F53\u8868\u672A\u89C1\u81F4\u547D\u6027\u673A\u68B0\u6027\u635F\u4F24\u3002\r\n\u989C\u9762\u5448\u9752\u7D2B\u8272\uFF0C\u53E3\u5507\u53CA\u7532\u5E8A\u7D2B\u7EC0\u660E\u663E\u3002\u53CC\u773C\u7403\u7ED3\u819C\u53EF\u89C1\u6563\u5728\u9488\u5C16\u72B6\u51FA\u8840\u70B9\uFF0C\u4EE5\u4E0A\u4E0B\u773C\u7751\u7ED3\u819C\u4E3A\u91CD\u3002\u9F3B\u8154\u53CA\u53E3\u8154\u5185\u672A\u89C1\u5F02\u7269\uFF0C\u4F46\u53E3\u8154\u9ECF\u819C\u53CA\u820C\u4F53\u8F7B\u5EA6\u6C34\u80BF\u3002\u5589\u5934\u9ECF\u819C\u663E\u8457\u6C34\u80BF\uFF0C\u58F0\u95E8\u88C2\u72ED\u7A84\uFF0C\u4F1A\u538C\u90E8\u80BF\u80C0\u5448\u7403\u72B6\u3002\u6C14\u7BA1\u9ECF\u819C\u5145\u8840\uFF0C\u7BA1\u8154\u5185\u53EF\u89C1\u5C11\u91CF\u6CE1\u6CAB\u72B6\u9ECF\u6DB2\u3002\u4E0A\u8FF0\u6539\u53D8\u7B26\u5408\u6025\u6027\u5589\u5934\u6C34\u80BF\u6240\u81F4\u4E0A\u547C\u5438\u9053\u963B\u585E\u7684\u5F62\u6001\u5B66\u7279\u5F81\u3002\r\n\u53CC\u80BA\u81A8\u9686\uFF0C\u8868\u9762\u53EF\u89C1\u808B\u9AA8\u538B\u75D5\u3002\u5207\u9762\u5448\u6697\u7EA2\u8272\uFF0C\u6324\u538B\u53EF\u89C1\u5927\u91CF\u7C89\u7EA2\u8272\u6CE1\u6CAB\u72B6\u6DB2\u4F53\u6EA2\u51FA\uFF0C\u7B26\u5408\u6025\u6027\u80BA\u6DE4\u8840\u3001\u80BA\u6C34\u80BF\u6539\u53D8\uFF0C\u4E0E\u8FC7\u654F\u6027\u4F11\u514B\u53CA\u5FC3\u6E90\u6027\u4F11\u514B\u7684\u7EC8\u672B\u8868\u73B0\u4E00\u81F4\u3002\r\n\r\n\u3010\u6BD2\u7406\u5B66\u62A5\u544A\u3011\r\n\u897F\u5730\u90A3\u975E\uFF1A\u8840\u836F\u6D53\u5EA6\u7EA61.2\u03BCg/mL\u3002\u786E\u8BA4\u6B7B\u4EA1\u524D1\u5C0F\u65F6\u5185\u53E3\u670D\u897F\u5730\u90A3\u975E\u5236\u5242\u3002\r\n\u785D\u9178\u7518\u6CB9\uFF1A\u8840\u6DB2\u4E2D\u68C0\u51FA\u5FAE\u91CF\uFF0C\u7ED3\u5408\u6B7B\u8005\u968F\u8EAB\u7269\u54C1\u4E2D\u6709\u785D\u9178\u7518\u6CB9\u820C\u4E0B\u542B\u5242\uFF0C\u7B26\u5408\u6B7B\u4EA1\u524D\u542B\u670D\u785D\u9178\u7518\u6CB9\u3002\r\n\u82B1\u751F\u7279\u5F02\u6027IgE\u6297\u4F53\uFF1A\u8840\u6E05\u4E2D\u68C0\u51FA\u9AD8\u6EF4\u5EA6\u82B1\u751F\u7279\u5F02\u6027IgE\u6297\u4F53\uFF0C\u7B26\u5408\u6B7B\u8005\u751F\u524D\u5DF2\u77E5\u82B1\u751F\u8FC7\u654F\u75C5\u53F2\u3002\r\n\u70B9\u5FC3\u6B8B\u6E23\uFF1A\u68C0\u51FA\u82B1\u751F\u7C89\u672B\u6210\u5206\u3002\r\n\u5FC3\u8840\u4E9A\u785D\u9178\u76D0\u6D53\u5EA69.7\u03BCg/mL\uFF0C\u9AD8\u94C1\u8840\u7EA2\u86CB\u767D\u9971\u548C\u5EA624%\u3002\r\n\r\n\u3010\u76F4\u63A5\u6B7B\u56E0\u3011\r\n\u5FC3\u6E90\u6027\u4F11\u514B\u731D\u6B7B\r\n\r\n\u3010\u5176\u4ED6\u53D1\u73B0\u3011\r\n\u6B7B\u8005\u5FC3\u810F\u51A0\u72B6\u52A8\u8109\u5DE6\u524D\u964D\u652F\u53EF\u89C1\u8F7B\u5EA6\u7CA5\u6837\u786C\u5316\u6591\u5757\uFF0C\u7BA1\u8154\u72ED\u7A84\u7EA630%\u3002\u80C3\u5BB9\u7269\u6D88\u5316\u7A0B\u5EA6\u8F83\u4F4E\uFF0C\u4ECD\u53EF\u89C1\u5927\u91CF\u76F8\u5BF9\u5B8C\u6574\u7684\u98DF\u7269\u6B8B\u6E23\uFF0C\u53EF\u7531\u6B64\u63A8\u5B9A\u8FDB\u98DF\u65F6\u95F4\u3002\r\n\r\n\u3010\u6B7B\u4EA1\u65F6\u95F4\u63A8\u5B9A\u3011\r\n\u7ED3\u5408\u5C38\u6591\u3001\u5C38\u50F5\u8FDB\u5C55\u7A0B\u5EA6\u3001\u53CA\u73AF\u5883\u6E29\u5EA6\uFF08\u4E1C\u4EAC\u5DE8\u86CB\u5185\u6052\u6E2922\u2103\uFF09\u7B49\u5404\u65B9\u9762\u7ED3\u679C\u8FDB\u884C\u7EFC\u5408\u6D4B\u7B97\uFF0C\u7ED3\u8BBA\uFF1A\u6B7B\u4EA1\u65F6\u95F4\u9AD8\u5EA6\u53EF\u80FD\u53D1\u751F\u5728\u53D1\u73B0\u5C38\u4F53\u524D\u534A\u5C0F\u65F6\u5185\uFF0C\u8BEF\u5DEE\u6781\u5C0F\u3002"
