  m_Script: {fileID: 11500000, guid: a797a7bbc187b28408d77a69535b4456, type: 3}
  m_Name: "2013\u661F\u9022"
  m_EditorClassIdentifier: 
  id: 2013
  displayName: "\u661F\u9022"
  detectable: 1
  collectable: 1
  collected: 0
  attackKey: 
  isAttackContentUnlocked: 0
  showAttackContentDirectly: 1
  attackUnlockContent: 
  summary: "\u5076\u50CF\u56E2\u4F53\uFF0C\u6210\u5458\u4E3A\u767D\u5DDD\u96EA\u4E43\u4E0E\u6A58\u65E5\u5411\uFF0C\u8FD1\u5E74\u6765\u7684\u65B0\u8D77\u4E4B\u79C0\uFF0C\u6210\u7EE9\u4F18\u5F02\uFF0C\u6781\u77ED\u65F6\u95F4\u5185\u8FBE\u6210\u767B\u4E0A\u4E1C\u4EAC\u5DE8\u86CB\u821E\u53F0\u7684\u6210\u7EE9\u3002"
  detailText: 
  Detail_Mark: "[\u7ED3\u679C]\uFF1A\u547D\u4E2D\u8BB0\u5F55 5800 \u6761\u3002\u6309\u5173\u8054\u5EA6\u4E0E\u53EF\u4FE1\u5EA6\u6392\u5E8F\u3002\r\n\r\n\u3010\u56E2\u4F53\u6863\u6848\u3011\r\n\u6210\u7ACB\u65F6\u95F4\uFF1A2050\u5E74\u3002\r\r\n\u6210\u5C31\uFF1A\u51FA\u9053\u5355\u66F2\u5373\u83B7\u5F97\u5468\u699C\u7B2C3\u540D\u3002\u6B64\u540E\u4E00\u5E74\u5185\u8FDE\u7EED\u53D1\u884C\u4E09\u5F20\u5355\u66F2\uFF0C\u5747\u8FDB\u5165\u524D\u4E94\u30022056\u5E74\u6210\u529F\u767B\u4E0A\u4E1C\u4EAC\u5DE8\u86CB\u4E3E\u529E\u4E13\u573A\u6F14\u5531\u4F1A\u3002\r\n\r\n\u3010\u6210\u5458\u4FE1\u606F\u3011\r\n\u5185\u5BB9\uFF1A\u6A58\u65E5\u5411\u4E3A\u56E2\u4F53\u521D\u4EE3Center\uFF0C\u51ED\u501F\u51FA\u8272\u7684\u6B4C\u5531\u80FD\u529B\u548C\u821E\u53F0\u8868\u73B0\u529B\u88AB\u89C6\u4E3A\u7EDD\u5BF9\u6838\u5FC3\u3002\u767D\u5DDD\u96EA\u4E43\u6700\u521D\u5B9A\u4F4D\u4E3A\u201C\u6E05\u65B0\u90BB\u5BB6\u59B9\u59B9\u201D\uFF0C\u4EBA\u6C14\u4E00\u822C\u3002\u81EA2055\u5E74\u4E0A\u534A\u5E74\u8D77\uFF0C\u767D\u5DDD\u96EA\u4E43\u5728\u7EFC\u827A\u8282\u76EE\u4E2D\u7684\u8868\u73B0\u9010\u6E10\u5438\u7C89\uFF0C\u793E\u4EA4\u5A92\u4F53\u5173\u6CE8\u6570\u53CD\u8D85\u6A58\u65E5\u5411\u30022055\u5E74\u521D\u7684\u7B2C\u4E09\u5F20\u5355\u66F2\u4E2D\uFF0CCenter\u4F4D\u7F6E\u9996\u6B21\u7531\u767D\u5DDD\u96EA\u4E43\u62C5\u4EFB\u3002\u6B64\u540E\u53CCCenter\u5E76\u884C\uFF0C\u4F46\u767D\u5DDD\u7684\u66DD\u5149\u7387\u663E\u8457\u9AD8\u4E8E\u6A58\u65E5\u5411\u3002\r\n\r\n\u3010\u4E0D\u548C\u4F20\u95FB\u3011\r\n\u6765\u6E90\uFF1A\u5A31\u4E50\u516B\u5366\u7F51\u7AD9\r\n\u5185\u5BB9\uFF1A\u591A\u4E2A\u533F\u540D\u5E16\u5B50\u79F0\u201C\u6A58\u65E5\u5411\u548C\u767D\u5DDD\u96EA\u4E43\u79C1\u4E0B\u6839\u672C\u4E0D\u8BF4\u8BDD\u201D\u3001\u201C\u540E\u53F0\u4E24\u4EBA\u4F11\u606F\u5BA4\u5206\u5F00\u201D\u3001\u201C\u91C7\u8BBF\u4E2D\u6A58\u65E5\u5411\u63D0\u5230\u767D\u5DDD\u65F6\u8BED\u6C14\u51B7\u6DE1\u201D\u3002\u6709\u6240\u8C13\u5DE5\u4F5C\u4EBA\u5458\u7206\u6599\u79F0\uFF0C\u6A58\u65E5\u5411\u5BF9\u5931\u53BBCenter\u4F4D\u7F6E\u5F88\u4E0D\u6EE1\uFF0C\u767D\u5DDD\u5219\u89C9\u5F97\u81EA\u5DF1\u662F\u9760\u5B9E\u529B\u4E0A\u4F4D\u7684\uFF0C\u4E24\u4EBA\u5173\u7CFB\u5F88\u50F5\u3002\r\n\u5B98\u65B9\u4FE1\u606F\u4E2D\u4ECE\u672A\u627F\u8BA4\u4EE5\u4E0A\u8206\u8BBA\uFF0C\u53CC\u65B9\u793E\u4EA4\u5A92\u4F53\u4E0A\u4ECD\u6709\u4E92\u52A8\u5408\u7167\u3002"
