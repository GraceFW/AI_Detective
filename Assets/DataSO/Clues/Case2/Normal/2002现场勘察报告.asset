  m_Script: {fileID: 11500000, guid: a797a7bbc187b28408d77a69535b4456, type: 3}
  m_Name: "2002\u73B0\u573A\u52D8\u5BDF\u62A5\u544A"
  m_EditorClassIdentifier: 
  id: 2002
  displayName: "\u73B0\u573A\u52D8\u5BDF\u62A5\u544A"
  detectable: 1
