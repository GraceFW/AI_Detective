    text: "\u60A8\u597D\uFF0C\u6211\u53EB\u6850\u751F\u83B2\u3002\u8BF7\u95EE\u4F20\u5524\u6211\u662F\u60F3\u505A\u4EC0\u4E48\u5462\uFF0C\u6211\u5E94\u8BE5\u6CA1\u505A\u4EC0\u4E48\u8FDD\u6CD5\u72AF\u7F6A\u7684\u4E8B\u5427\u3002"
