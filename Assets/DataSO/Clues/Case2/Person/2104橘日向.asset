  - shownClue: {fileID: 11400000, guid: cedbef1b9b00ea342beeb3daec62014c, type: 2}
    dialogues:
    - nodeId: 4
      text: "\u8001\u5934\u4E00\u4E2A\uFF0C\u538B\u6211\u7684\u8D44\u6E90\u3001\u538B\u767D\u5DDD\u7684\u5206\u6210\uFF0C\u8FD8\u7231\u8D2A\u5C0F\u4FBF\u5B9C\uFF0C\u73B0\u5728\u597D\u4E86\uFF0C\u628A\u81EA\u5DF1\u5403\u6B7B\u4E86\u3002\u6B7B\u4E86\u4E5F\u597D\uFF0C\u6240\u6709\u4EBA\u90FD\u89E3\u8131\u4E86\u3002"
      nextNodeId: 
      options:
      - optionId: "\u60A8\u7684\u610F\u601D\u662F\uFF1F"
        optionText: "\u60A8\u7684\u610F\u601D\u662F\uFF1F"
        nextNodeId: 5
    - nodeId: 5
      text: "\u5B57\u9762\u610F\u601D\u554A\uFF0C\u538B\u69A8\u4F60\u7684\u4EBA\u6CA1\u4E86\u4F60\u4E0D\u9AD8\u5174\uFF1F\u4ED6\u53EF\u662F\u5728\u6628\u5929\u6F14\u51FA\u7ED3\u675F\u540E\u8FD8\u628A\u6211\u53EB\u51FA\u53BB\u5F00\u4F1A\u2026\u2026\u4E00\u76F4\u5F00\u5230\u4E94\u70B9\u534A\u624D\u56DE\u4F11\u606F\u5BA4\uFF01\u2014\u2014\u54E6\uFF0C\u4E5F\u662F\u554A\uFF0C\u4F60\u662F\u673A\u5668\uFF0C\u4E0D\u61C2\u4EC0\u4E48\u53EB\u538B\u69A8\u3002"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 8fc5a776e23baa64791afffcceaa8b3f, type: 2}
    dialogues:
    - nodeId: 6
      text: "\u4ECA\u5929\u7684\u7C89\u4E1D\u4EEC\u771F\u662F\u70ED\u60C5\u554A\uFF01\u4ECA\u5929\u767D\u5DDD\u90A3\u5C0F\u59D1\u5A18\u53EF\u662F\u7D2F\u574F\u4E86\uFF0C\u800C\u4E14\u8FD8\u662F\u4E00\u5982\u65E2\u5F80\u7684\u4E0D\u77E5\u9053\u4F11\u606F\uFF0C\u8981\u4E0D\u662F\u524D\u8F88\u6211\u5927\u65B9\u5730\u5E2E\u52A9\u4E86\u5979\uFF0C\u641E\u4E0D\u597D\u5979\u73B0\u5728\u8FD8\u5728\u548C\u7C89\u4E1D\u4EEC\u63E1\u624B\u5462\uFF01\u5601\uFF0C\u8D44\u6E90\u597D\u8FD8\u4E0D\u77E5\u9053\u591A\u4F11\u606F\uFF0C\u8981\u662F\u8868\u73B0\u5DEE\u4E86\u8D44\u6E90\u4E0D\u5C31\u767D\u62FF\u4E86\uFF1F"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 95aacf91788fd0345a49903803720c6d, type: 2}
    dialogues:
    - nodeId: 7
      text: "\u767D\u5DDD\uFF1F\u90A3\u4E2A\u8F6F\u7EF5\u7EF5\u7684\u3001\u9A82\u5979\u4E5F\u4E0D\u77E5\u9053\u56DE\u5634\u7684\u5BB6\u4F19\uFF1F\u5C0F\u53EF\u601C\u4E00\u4E2A\uFF0C\u53EA\u77E5\u9053\u5FCD\u7740\u4E0D\u77E5\u9053\u8BF4\u8BDD\u3002\u6CA1\u5173\u7CFB\uFF0C\u4FDD\u62A4\u540E\u8F88\u662F\u524D\u8F88\u7684\u8D23\u4EFB\u3002"
      nextNodeId: 
      options:
      - optionId: "\u4E3A\u4E86\u4FDD\u62A4\u5979\uFF0C\u60A8\u505A\u4E86\u4EC0\u4E48\uFF1F"
        optionText: "\u4E3A\u4E86\u4FDD\u62A4\u5979\uFF0C\u60A8\u505A\u4E86\u4EC0\u4E48\uFF1F"
        nextNodeId: 8
    - nodeId: 8
      text: "\u554A\uFF0C\u6BD4\u5982\u8BF4\u5427\uFF0C\u4ECA\u5929\u63E1\u624B\u4F1A\u4E0A\u7684\u65F6\u5019\uFF0C\u8FD9\u5C0F\u59D1\u5A18\u624B\u90FD\u5FEB\u65AD\u4E86\u4E5F\u4E0D\u77E5\u9053\u6B47\u7740\uFF0C\u4E5F\u5C31\u662F\u524D\u8F88\u6211\u5927\u53D1\u6148\u60B2\u8BA9\u5979\u53BB\u4F11\u606F\u3002"
      nextNodeId: 9
      options: []
    - nodeId: 9
      text: "\u5E0C\u671B\u5979\u4EE5\u540E\u8BC6\u76F8\u70B9\uFF0C\u522B\u5360\u7740\u6211\u7684\u8D44\u6E90\uFF0C\u5148\u6765\u540E\u5230\u3001\u5C0A\u91CD\u524D\u8F88\uFF01\u8FDE\u8FD9\u90FD\u4E0D\u61C2\u2026\u2026"
