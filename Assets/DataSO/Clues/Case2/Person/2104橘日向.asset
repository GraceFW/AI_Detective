    - nodeId: 12
      text: "\u542C\u5230\u4E86\u8FD8\u95EE\uFF1F\uFF01\u8981\u4E0D\u662F\u90A3\u5BB6\u4F19\u5DF2\u7ECF\u6B7B\u4E86\uFF0C\u73B0\u5728\u8BE5\u88AB\u8B66\u5BDF\u8C03\u67E5\u7684\u4EBA\u5E94\u8BE5\u662F\u4ED6\u624D\u5BF9\u5427\uFF01"
