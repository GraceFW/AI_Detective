  - nodeId: 1
    text: "\u6211\u662F\u6A58\u65E5\u5411\u3002\u4F60\u5C31\u662F\u90A3\u4E2A\u95F9\u5F97\u6CB8\u6CB8\u626C\u626C\u3001\u6BD4\u6211\u98CE\u5934\u90FD\u76DB\u7684\u7535\u5B50\u4FA6\u63A2\uFF1F\u6709\u610F\u601D\u2026\u2026\u6709\u4EC0\u4E48\u5C31\u95EE\u5427\u3002"
    nextNodeId: 
