      options: []
    - nodeId: 14
      text: "\u2026\u2026\u5982\u679C\u6B7B\u4EA1\u4E0D\u662F\u51FA\u81EA\u53D7\u5BB3\u8005\u4E4B\u624B\uFF0C\u53C8\u6709\u4EC0\u4E48\u60E9\u7F5A\u53EF\u8A00\u5462\uFF1F\u51ED\u501F\u4E00\u6B7B\u4E86\u4E4B\u5C31\u53EF\u4EE5\u9003\u8131\u60E9\u7F5A\uFF0C\u771F\u662F\u592A\u8F7B\u677E\u4E86\u554A\u2026\u2026"
