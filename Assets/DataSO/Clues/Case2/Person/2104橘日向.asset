  detectable: 1
  collectable: 1
  collected: 0
  attackKey: 
  isAttackContentUnlocked: 0
  showAttackContentDirectly: 1
  attackUnlockContent: 
  summary: "\u59D3\u540D\uFF1A\u6A58\u65E5\u5411\r\n\u72B6\u6001\uFF1A\u5076\u50CF\u827A\u4EBA\r\n\u767D\u5DDD\u96EA\u4E43\u7684\u56E2\u5458\u3001\u524D\u8F88\u3002\u8D44\u5386\u66F4\u8001\u5374\u8D44\u6E90\u5F85\u9047\u5404\u65B9\u9762\u5747\u4E0D\u5982\u767D\u5DDD\u96EA\u4E43\u6EE1\u3002"
  detailText: 
  Detail_Mark: "[\u7ED3\u679C]\uFF1A\u547D\u4E2D\u8BB0\u5F553684851\u6761\u3002\u6309\u5173\u8054\u5EA6\u4E0E\u53EF\u4FE1\u5EA6\u6574\u5408\u3002\r\n\r\n\u3010\u57FA\u672C\u4FE1\u606F\u6458\u8981\u3011\r\n\u6570\u636E\u5C42\u6765\u6E90\uFF1A\u5929\u5DDD\u6F14\u827A\u4E8B\u52A1\u6240\u827A\u4EBA\u7BA1\u7406\u90E8\u7535\u5B50\u6863\u6848\r\n\u59D3\u540D\uFF1A\u6A58
    \u65E5\u5411\r\n\u5E74\u9F84\uFF1A22\u5C81\r\n\u804C\u4F4D\uFF1A\u5076\u50CF\u56E2\u4F53\u661F\u9022\u6210\u5458\r\n\u51FA\u9053\u65F6\u95F4\uFF1A2052\u5E74\r\n\r\n\u3010\u5386\u53F2\u4FE1\u606F\u3011\r\n\u6765\u6E90\uFF1A\u5929\u5DDD\u6F14\u827A\u5B98\u7F51\r\n\u6A58\u65E5\u5411\u4E8E2050\u5E74\u4EE515\u5C81\u901A\u8FC7\u7504\u9009\uFF0C\u6210\u4E3A\u5929\u5DDD\u6F14\u827A\u7814\u4FEE\u751F\u3002\u7ECF\u4E24\u5E74\u57F9\u8BAD\u540E\uFF0C\u4E8E2052\u5E74\u4EE5\u300C\u661F\u9022\u300D\u6210\u5458\u8EAB\u4EFD\u51FA\u9053\u3002\u56E2\u4F53\u51FA\u9053\u521D\u671F\u7531\u9AD8\u5CF0\u8BDA\u4E00\u90CE\u76F4\u63A5\u4F01\u5212\uFF0C\u5B9A\u4F4D\u4E3A\u201C\u590F\u591C\u5E7B\u60F3\u7CFB\u5076\u50CF\u201D\u3002\u5185\u8BC4\u4EF7\u5176\u201C\u58F0\u7EBF\u8FA8\u8BC6\u5EA6\u6781\u9AD8\u3001\u821E\u53F0\u7ECF\u9A8C\u4E30\u5BCC\u201D\u3002\u516C\u5F00\u6E20\u9053\u65E0\u4E11\u95FB\u6216\u5408\u7EA6\u7EA0\u7EB7\u8BB0\u5F55\u3002"
  portrait: {fileID: 21300000, guid: 452cb900429480141a82b943e6763c26, type: 3}
  canBeSummoned: 1
  baseDialogues:
  - nodeId: 1
    text: "\u6211\u662F\u6A58\u65E5\u5411\u3002\u4F60\u5C31\u662F\u90A3\u4E2A\u95F9\u5F97\u6CB8\u6CB8\u626C\u626C\u3001\u6BD4\u6211\u98CE\u5934\u90FD\u76DB\u7684\u7535\u5B50\u4FA6\u63A2\uFF1F\u6709\u610F\u601D\u2026\u2026\u6709\u4EC0\u4E48\u5C31\u95EE\u5427\u3002"
    nextNodeId: 
    options: []
  fallbackDialogues:
  - nodeId: 0
    text: "\u54C8\uFF1F\u542C\u4E0D\u61C2\u554A\uFF0C\u4F60\u8FD9\u5BB6\u4F19\u5728\u8BF4\u4EC0\u4E48\u5462\u3002"
    nextNodeId: 
    options: []
  clueDialogues:
  - shownClue: {fileID: 11400000, guid: bb30f6e4f23e8814195b6dc570397428, type: 2}
    dialogues:
    - nodeId: 2
      text: "\u90A3\u4E2A\u2026\u2026\u5C31\u90A3\u4E2A\u767D\u5DDD\u7684\u6B7B\u5FE0\u7C89\uFF1F\u54FC\u2026\u2026\u6211\u600E\u4E48\u5C31\u6CA1\u6709\u8FD9\u4E48\u70ED\u60C5\u7684\u7C89\u4E1D\u2026\u2026"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 36e9e5219b6fcb344ae53d7abe6874e2, type: 2}
    dialogues:
    - nodeId: 3
      text: "\u4E0D\u5C31\u662F\u9AD8\u5CF0\u6B7B\u6389\u7684\u5730\u65B9\uFF1F\u4E00\u89C8\u65E0\u4F59\uFF0C\u771F\u4E0D\u77E5\u9053\u6709\u4EC0\u4E48\u597D\u95EE\u7684\u3002"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: cedbef1b9b00ea342beeb3daec62014c, type: 2}
    dialogues:
    - nodeId: 4
      text: "\u8001\u5934\u4E00\u4E2A\uFF0C\u538B\u6211\u7684\u8D44\u6E90\u3001\u538B\u767D\u5DDD\u7684\u5206\u6210\uFF0C\u8FD8\u7231\u8D2A\u5C0F\u4FBF\u5B9C\uFF0C\u73B0\u5728\u597D\u4E86\uFF0C\u628A\u81EA\u5DF1\u5403\u6B7B\u4E86\u3002\u6B7B\u4E86\u4E5F\u597D\uFF0C\u6240\u6709\u4EBA\u90FD\u89E3\u8131\u4E86\u3002"
      nextNodeId: 
      options:
      - optionId: "\u60A8\u7684\u610F\u601D\u662F\uFF1F"
        optionText: "\u60A8\u7684\u610F\u601D\u662F\uFF1F"
        nextNodeId: 5
    - nodeId: 5
      text: "\u5B57\u9762\u610F\u601D\u554A\uFF0C\u538B\u69A8\u4F60\u7684\u4EBA\u6CA1\u4E86\u4F60\u4E0D\u9AD8\u5174\uFF1F\u54E6\uFF0C\u4F60\u662F\u673A\u5668\uFF0C\u4E0D\u61C2\u4EC0\u4E48\u53EB\u538B\u69A8\u3002"
      nextNodeId: 
      options:
      - optionId: "\u8BF7\u95EE\u60A8\u6240\u8BF4\u7684\u538B\u69A8\u6307\u7684\u662F\u4EC0\u4E48\uFF1F"
        optionText: "\u8BF7\u95EE\u60A8\u6240\u8BF4\u7684\u538B\u69A8\u6307\u7684\u662F\u4EC0\u4E48\uFF1F"
        nextNodeId: 6
    - nodeId: 6
      text: "\u6C38\u4E0D\u505C\u606F\u7684\u8BAD\u7EC3\uFF0C\u65E0\u7A77\u65E0\u5C3D\u7684\u6F14\u51FA\uFF0C\u53BB\u4E86\u53C8\u6765\u7684\u901A\u544A\u2026\u2026\u8FD9\u53EA\u662F\u51B0\u5C71\u4E00\u89D2\u3002"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 95aacf91788fd0345a49903803720c6d, type: 2}
    dialogues:
    - nodeId: 7
      text: "\u767D\u5DDD\uFF1F\u90A3\u4E2A\u8F6F\u7EF5\u7EF5\u7684\u3001\u9A82\u5979\u4E5F\u4E0D\u77E5\u9053\u56DE\u5634\u7684\u5BB6\u4F19\uFF1F\u5C0F\u53EF\u601C\u4E00\u4E2A\uFF0C\u53EA\u77E5\u9053\u5FCD\u7740\u4E0D\u77E5\u9053\u8BF4\u8BDD\u3002\u6CA1\u5173\u7CFB\uFF0C\u4FDD\u62A4\u540E\u8F88\u662F\u524D\u8F88\u7684\u8D23\u4EFB\u3002"
      nextNodeId: 
      options:
      - optionId: "\u4E3A\u4E86\u4FDD\u62A4\u5979\uFF0C\u60A8\u505A\u4E86\u4EC0\u4E48\uFF1F"
        optionText: "\u4E3A\u4E86\u4FDD\u62A4\u5979\uFF0C\u60A8\u505A\u4E86\u4EC0\u4E48\uFF1F"
        nextNodeId: 8
    - nodeId: 8
      text: "\u554A\uFF0C\u6BD4\u5982\u8BF4\u5427\uFF0C\u4ECA\u5929\u63E1\u624B\u4F1A\u4E0A\u7684\u65F6\u5019\uFF0C\u8FD9\u5C0F\u59D1\u5A18\u624B\u90FD\u5FEB\u65AD\u4E86\u4E5F\u4E0D\u77E5\u9053\u6B47\u7740\uFF0C\u4E5F\u5C31\u662F\u524D\u8F88\u6211\u5927\u53D1\u6148\u60B2\u8BA9\u5979\u53BB\u4F11\u606F\u3002"
      nextNodeId: 9
      options: []
    - nodeId: 9
      text: "\u5E0C\u671B\u5979\u4EE5\u540E\u8BC6\u76F8\u70B9\uFF0C\u522B\u5360\u7740\u6211\u7684\u8D44\u6E90\uFF0C\u5148\u6765\u540E\u5230\u3001\u5C0A\u91CD\u524D\u8F88\uFF01\u8FDE\u8FD9\u90FD\u4E0D\u61C2\u2026\u2026"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 213259c5e1d1b3b4e9099a4fc0a16c2d, type: 2}
    dialogues:
    - nodeId: 10
      text: "\u8C01\uFF1F\u6709\u70B9\u8033\u719F\u2026\u2026\u4F60\u8BF4\u8DDF\u7740\u5316\u5986\u5E08\u8DD1\u817F\u7684\u5B66\u5F92\uFF1F\u54E6\uFF0C\u4ED6\u597D\u50CF\u4F1A\u5E2E\u7740\u9001\u996D\u642C\u4E1C\u897F\u4EC0\u4E48\u7684\uFF0C\u4ECA\u665A\u665A\u996D\u548C\u90A3\u4E9B\u7C89\u4E1D\u9001\u6765\u7684\u793C\u7269\u597D\u50CF\u5C31\u662F\u4ED6\u642C\u6765\u7684\u3002"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 4f816dc0c1e80d7458616695a1dc2fd8, type: 2}
    dialogues:
    - nodeId: 11
      text: "\u5601\u2026\u2026\u90A3\u8001\u4E1C\u897F\u5E74\u7EAA\u5927\u4E86\uFF0C\u5403\u8FD9\u4E2A\u4E5F\u5F88\u6B63\u5E38\u5427\uFF1F\u8FD9\u8001\u4E1C\u897F\u2026\u2026\u5403\u4E86\u8FD9\u4E2A\u8FD8\u4E0D\u5230\u4E94\u5206\u949F\uFF01"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: cbc7d7fcd1e6209468a1ae21c916e098, type: 2}
    dialogues:
    - nodeId: 12
      text: "\u542C\u5230\u4E86\u8FD8\u95EE\uFF1F\uFF01\u8981\u4E0D\u662F\u90A3\u5BB6\u4F19\u5DF2\u7ECF\u6B7B\u4E86\uFF0C\u73B0\u5728\u8BE5\u88AB\u8B66\u5BDF\u8C03\u67E5\u7684\u4EBA\u5E94\u8BE5\u662F\u4ED6\u624D\u5BF9\u5427\uFF01"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: c0c69103c59cecb4d85ca19b61aed48f, type: 2}
    dialogues:
    - nodeId: 13
      text: "\u55EF\uFF1F\u8FD9\u4E0D\u662F\u6211\u4EA4\u4E0A\u53BB\u7684\u624B\u673A\u5417\u2026\u2026\u6211\u53EF\u4E0D\u4F1A\u628A\u5BC6\u7801\u544A\u8BC9\u4F60\u4EEC\u7684\uFF01\u51ED\u4EC0\u4E48\u554A\uFF0C\u660E\u660E\u81EA\u5DF1\u6CA1\u6709\u7F6A\uFF0C\u5374\u8981\u83AB\u540D\u5176\u5999\u516C\u5F00\u81EA\u5DF1\u7684\u8D44\u6599\u3002\u6211\u53EF\u662F\u827A\u4EBA\uFF0C\u827A\u4EBA\u554A\uFF01\u8981\u662F\u91CC\u9762\u7684\u9690\u79C1\u6CC4\u6F0F\u51FA\u53BB\u4E86\uFF0C\u6211\u4E4B\u540E\u600E\u4E48\u529E\uFF1F"
      nextNodeId: 14
      options: []
    - nodeId: 14
      text: "\u5601\u2026\u2026\u4E0D\u901A\u4EBA\u6027\u7684\u94C1\u7599\u7629\uFF0C\u5230\u5E95\u662F\u8C01\u60F3\u51FA\u6765\u7684\u8BA9\u4F60\u5BA1\u8BAF\uFF1F"
      nextNodeId: 
      options: []
    singleUse: 0
