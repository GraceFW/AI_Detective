  id: 1102
  displayName: "\u677E\u4E95\u65E9\u82D7"
  detectable: 1
  collectable: 1
  collected: 1
  attackKey: 
  isAttackContentUnlocked: 0
  showAttackContentDirectly: 1
  attackUnlockContent: 
  summary: "\u59D3\u540D\uFF1A\u677E\u4E95\u65E9\u82D7\r\n\u72B6\u6001\uFF1A\u5BB6\u5EAD\u4E3B\u5987\r\n\u5E86\u5E94\u5927\u5B662040\u5C4A\u6BD5\u4E1A\u751F\r\n\u5A5A\u59FB\u72B6\u6001\uFF1A\u5DF2\u5A5A\r\n\u5728\u6821\u671F\u95F4\u4EBA\u6C14\u5F88\u9AD8\uFF0C\u66FE\u62C5\u4EFB\u6587\u5316\u90E8\u90E8\u957F\uFF0C\u5F88\u53D7\u6B22\u8FCE\uFF0C\u6BD5\u4E1A\u540E\u4E0E\u5F53\u65F6\u6210\u7EE9\u4F18\u5F02\u7684\u677E\u4E95\u77F3\u6839\u7ED3\u5A5A\uFF0C\u6210\u4E3A\u5BB6\u5EAD\u4E3B\u5987\u3002\u4E8C\u4EBA\u80B2\u6709\u4E00\u5973\u3002"
  detailText: 
  Detail_Mark: "[\u7ED3\u679C]\uFF1A\u547D\u4E2D\u8BB0\u5F55230\u6761\u3002\u6309\u5173\u8054\u5EA6\u4E0E\u53EF\u4FE1\u5EA6\u6574\u5408\u3002\r\n\r\n\u3010\u57FA\u672C\u4FE1\u606F\u6458\u8981\u3011\r\n\u6570\u636E\u5C42\u6765\u6E90\uFF1A\u6237\u7C4D\u767B\u8BB0\u7CFB\u7EDF\r\n\u59D3\u540D\uFF1A\u677E\u4E95
    \u65E9\u82D7\r\n\u5E74\u9F84\uFF1A38\u5C81\r\n\u804C\u4F4D\uFF1A\u65E0\u4E1A\r\n\u5A5A\u59FB\u72B6\u6001\uFF1A\u5DF2\u5A5A\r\n\u7ED3\u5A5A\u65F6\u95F4\uFF1A2045\u5E74\r\n\u5B66\u5386\uFF1A2044\u5E74\u83B7\u5E86\u5E94\u5927\u5B66\u5B66\u58EB\u5B66\u4F4D\r\n\r\n\u3010\u52A8\u6001\u4FE1\u606F\u3011\r\n\u6765\u6E90\uFF1A\u5E86\u5E94\u5927\u5B66\u5B98\u7F51\u3001\u5E86\u5E94\u5927\u5B66\u8BBA\u575B\r\n\u677E\u4E95\u65E9\u82D7\u5728\u6821\u671F\u95F4\uFF0C\u56E0\u4E3A\u7F8E\u8C8C\uFF0C\u5916\u5411\uFF0C\u66FE\u62C5\u4EFB\u5B66\u751F\u4F1A\u6587\u5316\u90E8\u90E8\u957F\uFF0C\u4E3B\u6301\u591A\u4E2A\u6821\u56ED\u5927\u578B\u6D3B\u52A8\uFF0C\u5728\u6821\u56ED\u4E2D\u5E7F\u53D7\u6B22\u8FCE\u3002"
  portrait: {fileID: 21300000, guid: e1c70304aa8ac244698993389355aff1, type: 3}
  canBeSummoned: 1
  baseDialogues:
  - nodeId: 1
    text: "\u60A8\uFF0C\u60A8\u597D\u2026\u2026\u6211\u662F\u677E\u4E95\u65E9\u82D7\uFF0C\u662F\u6211\u548C\u51AC\u9A6C\u5148\u751F\u4E00\u8D77\u62A5\u7684\u6848\u2026\u2026\u60A8\u5C4F\u5E55\u4E0A\u7684\u5B57\u662F\u60A8\u7684\u540D\u5B57\u5417\uFF1F\u5DE5\u85E4\u5148\u751F\u3001\u4E0D\uFF0C\u5DE5\u85E4\u541B\uFF0C\u5443\u2026\u2026\u5341\u5206\u5192\u6627\uFF0C\u8BF7\u95EE\u6211\u5E94\u8BE5\u5982\u4F55\u79F0\u547C\u60A8\u2026\u2026\uFF1F"
    nextNodeId: 
    options:
    - optionId: "\u79F0\u547C\u6211\u5DE5\u85E4\u65B0\u4E00\u5C31\u597D"
      optionText: "\u79F0\u547C\u6211\u5DE5\u85E4\u65B0\u4E00\u5C31\u597D"
      nextNodeId: 2
  - nodeId: 2
    text: "\u2026\u2026\u597D\u7684\uFF0C\u5DE5\u85E4\u541B\uFF0C\u8BF7\u591A\u6307\u6559\u4E86\u3002"
    nextNodeId: 
    options:
    - optionId: "\u63CF\u8FF0\u73B0\u573A\u60C5\u51B5"
      optionText: "\u63CF\u8FF0\u73B0\u573A\u60C5\u51B5"
      nextNodeId: 3
  - nodeId: 3
    text: "\u6211\u2026\u2026\u524D\u4E00\u5929\u6211\u4EEC\u5435\u67B6\u4E86\uFF0C\u7136\u540E\uFF0C\u4ECA\u5929\u6211\u5C31\u60F3\u7740\uFF0C\u8981\u627E\u4ED6\u8C08\u4E00\u8C08\u2026\u2026\u56E0\u4E3A\u4ED6\u4E0B\u73ED\u4E4B\u540E\u5E38\u5E38\u4E0D\u56DE\u5BB6\uFF0C\u6211\u5C31\u60F3\u7740\u8981\u6765\u516C\u53F8\u627E\u4ED6\u3002\u672C\u6765\u60F3\u7740\u665A\u996D\u65F6\u95F4\u4ED6\u4E00\u5B9A\u4F1A\u4E0B\u697C\uFF0C\u4F46\u6211\u4E00\u76F4\u7B49\u5230\u4E03\u70B9\u591A\uFF0C\u8FD8\u662F\u6CA1\u6709\u770B\u5230\u4ED6\uFF0C\u6211\u5B9E\u5728\u6709\u4E9B\u7740\u6025\u4E86\uFF0C\u5C31\u4E0A\u53BB\u627E\u4ED6\u3002\n\u4E0A\u53BB\u4E4B\u540E\u6B63\u597D\u78B0\u5230\u4ED6\u4EEC\u516C\u53F8\u5458\u5DE5\u4E0B\u73ED\uFF0C\u51AC\u9A6C\u541B\u4E5F\u5728\uFF0C\u6211\u5C31\u8BE2\u95EE\u4ED6\u4ECA\u665A\u662F\u4E0D\u662F\u6709\u52A0\u73ED\uFF0C\u4ED6\u8BF4\u6709\u90E8\u95E8\u4F1A\u8BAE\uFF0C\u4F46\u662F\u77F3\u6839\u4ED6\u6CA1\u6709\u51FA\u5E2D\u2026\u2026\u6211\u6709\u70B9\u7740\u6025\uFF0C\u5C31\u8BF7\u4ED6\u5E26\u6211\u8FDB\u53BB\u627E\u4ED6\uFF0C\u7ED3\u679C\u51AC\u9A6C\u4E00\u5F00\u95E8\u6211\u5C31\u770B\u5230\u2026\u2026\u5C31\u770B\u5230\u2026\u2026\n\u2026\u2026\u6211\u3001\u6211\u5C31\u77E5\u9053\u8FD9\u4E48\u591A\u2026\u2026\u5982\u679C\u53EF\u4EE5\u7684\u8BDD\u2026\u2026\u8BF7\u52A1\u5FC5\u627E\u51FA\u6740\u5BB3\u4ED6\u7684\u72AF\u4EBA\u2026\u2026"
    nextNodeId: 
    options: []
  - nodeId: 6
    text: "\u54E6\uFF0C\u60A8\u8BF4\u4FBF\u5F53\u7684\u5185\u5BB9\uFF0C\u662F\u7684\uFF0C\u662F\u7684\uFF0C\u6211\u51C6\u5907\u4E86\u996D\u56E2\u914D\u6885\u5B50\uFF0C\u5916\u9762\u5305\u4E86\u6D77\u82D4\u2026\u2026"
    nextNodeId: 
    options: []
  - nodeId: 8
    text: "\u2026\u2026 \u597D\u5427\u3002\u4ED6\u786E\u5B9E\u6253\u4E86\u6211\u3002\u4E0D\u8FC7\u6211\u662F\u6E05\u767D\u7684\uFF01\u6211\u4E00\u76F4\u5230\u4E03\u70B9\u534A\u624D\u4E0A\u697C\uFF0C\u8FD9\u4E4B\u524D\u6211\u4E00\u76F4\u5728\u697C\u4E0B\uFF0C\u4FDD\u5B89\uFF0C\u76D1\u63A7\u8FD8\u6709\u51AC\u9A6C\u90FD\u53EF\u4EE5\u8BC1\u660E\u7684\uFF0C\u6211\u6CA1\u65F6\u95F4\u6740\u4ED6\uFF01
      \u8FD8\u6709\uFF0C\u8FD8\u6709\u5C31\u662F\u6211\u4ECA\u5929\u662F\u6765\u627E\u4ED6\u548C\u597D\u7684\uFF0C\u90A3\u4E2A\uFF0C\u6211\uFF0C\u4F60\u53EF\u4EE5\u627E\u51AC\u9A6C\u95EE\uFF0C\u4ED6\u77E5\u9053\u6211\u4ECA\u5929\u662F\u6765\u627E\u77F3\u6839\u548C\u597D\u7684\uFF0C\u6240\u4EE5\u624D\u5E26\u6211\u53BB\u627E\u4ED6\u2026\u2026"
    nextNodeId: 
    options: []
  - nodeId: 9
    text: "\u7B97\u662F\u5427\uFF0C\u8FD9\u4E2A\u6211\u4E5F\u6709\u8BC1\u636E\uFF01\u6211\u8FD9\u91CC\u6709\u4ED6\u5728\u4E0A\u4E2A\u6708\u7684\u6D88\u8D39\u8BB0\u5F55\uFF0C\u4ED6\u5728\u5F39\u73E0\u5E97\u82B1\u7684\u6BD4\u4ED6\u4E00\u4E2A\u6708\u7684\u5DE5\u8D44\u90FD\u591A\u597D\u51E0\u500D\uFF01\u5929\u77E5\u9053\u4ED6\u54EA\u513F\u6765\u7684\u8FD9\u4E48\u591A\u94B1\u3002"
    nextNodeId: 
    options: []
  fallbackDialogues:
  - nodeId: 20
    text: "\u8FD9\u4E2A\u2026\u2026\u6211\u5B9E\u5728\u662F\u4E0D\u592A\u6E05\u695A\u2026\u2026"
    nextNodeId: 
