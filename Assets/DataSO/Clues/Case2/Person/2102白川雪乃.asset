    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 8865ca875eb135443ab9fb21e6f3f833, type: 2}
    dialogues:
    - nodeId: 9
      text: "\u6A58\u524D\u8F88\u2026\u2026\u662F\u5F88\u597D\u7684\u4EBA\u3002"
      nextNodeId: 10
      options: []
    - nodeId: 10
      text: "\u867D\u7136\u6027\u683C\u4E0A\u98CE\u98CE\u706B\u706B\u7684\uFF0C\u4F46\u662F\u4E5F\u662F\u4E2A\u771F\u8BDA\u7684\u597D\u4EBA\u3002\u5979\u4E00\u76F4\u90FD\u5F88\u770B\u91CD\u81EA\u5DF1\u7684\u4E8B\u4E1A\uFF0C\u4E5F\u4E00\u76F4\u90FD\u975E\u5E38\u52AA\u529B\u4E86\u2026\u2026\u5979\u4ECA\u5929\u8FD8\u7279\u522B\u9AD8\u5174\u5730\u544A\u8BC9\u6211\u8BF4\uFF0C\u4E3A\u4E86\u7EAA\u5FF5\u4ECA\u5929\u7B2C\u4E00\u6B21\u767B\u4E0A\u4E1C\u4EAC\u5DE8\u86CB\u6F14\u51FA\uFF0C\u628A\u5BC6\u7801\u6539\u6210\u4E86\u4ECA\u5929\u5462\u3002"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 213259c5e1d1b3b4e9099a4fc0a16c2d, type: 2}
    dialogues:
    - nodeId: 11
      text: "\u4ED6\u662F\u2026\u2026\u6211\u7684\u604B\u4EBA\u3002\u4ED6\u603B\u662F\u90A3\u4E48\u6127\u759A\uFF0C\u4E00\u76F4\u5728\u4E3A\u4E86\u5E2E\u4E0A\u6211\u7684\u5FD9\u800C\u52AA\u529B\u3002\u4ED6\u4E3A\u4E86\u66F4\u5FEB\u5730\u5B66\u6210\u51FA\u5E08\u51CF\u8F7B\u6211\u7684\u538B\u529B\uFF0C\u9664\u4E86\u6280\u672F\u7684\u5B66\u4E60\uFF0C\u4ED6\u8FD8\u603B\u662F\u5E2E\u8001\u5E08\u548C\u516C\u53F8\u5E72\u4E9B\u6742\u4E8B\uFF0C\u8D62\u5F97\u8001\u5E08\u7684\u597D\u611F\u3002\u5C31\u50CF\u6BCF\u6B21\u6536\u5230\u7C89\u4E1D\u793C\u7269\uFF0C\u90FD\u662F\u4ED6\u6574\u7406\u3002"
      nextNodeId: 12
      options: []
    - nodeId: 12
      text: "\u56E0\u4E3A\u6211\u4F5C\u4E3A\u5076\u50CF\u7684\u8EAB\u4EFD\uFF0C\u6211\u4EEC\u4E24\u5E74\u6765\u90FD\u662F\u8F9B\u82E6\u7684\u5730\u4E0B\u604B\u60C5\u2026\u2026\u5C3D\u7BA1\u5982\u6B64\uFF0C\u53EA\u8981\u6709\u5F7C\u6B64\u5728\u8EAB\u8FB9\uFF0C\u6211\u4EEC\u4E5F\u4F9D\u65E7\u5F88\u5E78\u798F\u3002\u4E3A\u4E86\u4ED6\u6211\u613F\u610F\u505A\u4EFB\u4F55\u4E8B\u3002\n\u8FD9\u4E48\u8BF4\u8D77\u6765\uFF0C\u8FDE\u624B\u673A\u5BC6\u7801\u90FD\u662F\u6211\u4EEC\u7684\u604B\u7231\u7EAA\u5FF5\u65E5\u5462\u2014\u2014\u90FD\u5DF2\u7ECF\uFF0C\u6574\u6574\u4E24\u5468\u5E74\u4E86\u554A\u2026\u2026"
      nextNodeId: 
      options:
      - optionId: "\u5305\u62EC\u6740\u4EBA\uFF1F"
        optionText: "\u5305\u62EC\u6740\u4EBA\uFF1F"
        nextNodeId: 13
      - optionId: "\u60A8\u8BF4\uFF0C\u6850\u751F\u83B2\u5148\u751F\u8D1F\u8D23\u6574\u7406\u7C89\u4E1D\u793C\u7269\uFF1F"
        optionText: "\u60A8\u8BF4\uFF0C\u6850\u751F\u83B2\u5148\u751F\u8D1F\u8D23\u6574\u7406\u7C89\u4E1D\u793C\u7269\uFF1F"
        nextNodeId: 14
    - nodeId: 13
      text: "\u662F\u7684\uFF0C\u4E00\u5207\u3002\u6211\u4F1A\u4FDD\u62A4\u4ED6\uFF0C\u5C31\u50CF\u4ED6\u4FDD\u62A4\u6211\u4E00\u6837\u3002"
      nextNodeId: 
      options: []
    - nodeId: 14
      text: "\u2026\u2026\u5BF9\uFF0C\u8FD9\u662F\u4ED6\u7684\u5DE5\u4F5C\u3002\u6628\u5929\u6F14\u51FA\u7ED3\u675F\u540E\uFF0C\u5927\u6982\u4E94\u70B9\u4E94\u5206\uFF0C\u8FD8\u662F\u4ED6\u5E2E\u5FD9\u628A\u6574\u7406\u5B8C\u7684\u7C89\u4E1D\u793C\u7269\u5E26\u56DE\u4F11\u606F\u5BA4\u3002"
      nextNodeId: 
      options:
      - optionId: "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u53EA\u6709\u4ED6\u5355\u72EC\u63A5\u89E6\u8FD9\u6279\u793C\u7269\uFF1F"
        optionText: "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u53EA\u6709\u4ED6\u5355\u72EC\u63A5\u89E6\u8FD9\u6279\u793C\u7269\uFF1F"
        nextNodeId: 15
    - nodeId: 15
      text: "\u662F\u7684\u3002\u7B49\u7B49\uFF0C\u4EC0\u4E48\uFF1F\u4F60\u662F\u60F3\u8BF4\u83B2\u5BF9\u793C\u7269\u505A\u4E86\u624B\u811A\u5417\uFF1F\u4E0D\u2026\u2026\u4E0D\u662F\u4ED6\uFF0C\u662F\u6211\u505A\u7684\uFF0C\u662F\u6211\u2026\u2026"
