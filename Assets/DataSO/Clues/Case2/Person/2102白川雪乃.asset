  - shownClue: {fileID: 11400000, guid: 1b1049098f6931c45969f49399b28c49, type: 2}
    dialogues:
    - nodeId: 11
      text: "\u554A\uFF0C\u4F60\u662F\u8BF4\u6211\u548C\u51AC\u9A6C\u541B\u7684\u5173\u7CFB\u3002\u6211\u4EEC\u5728\u5927\u5B66\u7684\u65F6\u5019\u662F\u540C\u5B66\uFF0C\u90FD\u5728\u5B66\u751F\u4F1A\u6709\u5DE5\u4F5C\u2026\u2026\u90A3\u53EF\u771F\u662F\u9752\u6625\u7684\u6821\u56ED\u65F6\u5149\u554A\u3002\u6211\u5728\u6587\u5316\u90E8\uFF0C\u4ED6\u5728\u4F53\u80B2\u90E8\u3002\u5076\u5C14\u5728\u8FD0\u52A8\u4F1A\u4E4B\u7C7B\u7684\u6D3B\u52A8\u4E0A\u90FD\u4F1A\u5408\u4F5C\u3002\u4E0D\u8FC7\uFF0C\u540E\u6765\u6211\u6BD5\u4E1A\u4E4B\u540E\u548C\u77F3\u6839\u7ED3\u5A5A\uFF0C\u6CA1\u6709\u4E86\u5DE5\u4F5C\u4E0A\u7684\u4EA4\u96C6\uFF0C\u4E5F\u5C31\u4E0D\u8054\u7CFB\u4E86\u2026\u2026\u6CA1\u60F3\u5230\u4ED6\u4E5F\u5728\u512A\u54C1\u5802\u5DE5\u4F5C\uFF0C\u4ECA\u5929\u78B0\u5230\u4E86\u4E5F\u5F88\u60CA\u559C\uFF0C\u5C31\u5728\u697C\u4E0B\u7684\u5496\u5561\u5385\u5750\u4E86\u4E00\u4F1A\u513F\uFF0C\u8FB9\u7B49\u8FB9\u804A\u4E86\u51E0\u53E5\u3002"
