  clueDialogues:
  - shownClue: {fileID: 11400000, guid: ff9327d0ee0d9454693be54815e1d9ca, type: 2}
    dialogues:
    - nodeId: 4
      text: "\u54E6\uFF0C\u60A8\u662F\u8BF4\u4E3A\u4EC0\u4E48\u6211\u8981\u7B49\u5230\u665A\u996D\u65F6\u95F4\u624D\u53BB\u627E\u4ED6\u3002\u8FD9\u4E2A\u662F\u56E0\u4E3A\uFF0C\u4ED6\u4EEC\u5199\u5B57\u697C\u697C\u4E0B\u6709\u95E8\u7981\uFF0C\u8BBF\u5BA2\u5FC5\u987B\u8981\u8054\u7CFB\u516C\u53F8\u7684\u4EBA\u624D\u80FD\u6253\u5F00\u54E6\u3002\u6BD5\u7ADF\u592B\u59BB\u5435\u67B6\u8FD9\u79CD\u4E8B\u2026\u2026\u6211\u4E5F\uFF0C\u6211\u4E5F\u4E0D\u662F\u5F88\u60F3\u8BA9\u5168\u516C\u53F8\u7684\u4EBA\u90FD\u77E5\u9053\u6211\u6765\u627E\u4ED6\u3002\u77F3\u6839\u4E4B\u524D\u544A\u8BC9\u8FC7\u6211\uFF0C\u4ED6\u4EEC\u516C\u53F8\u4E2D\u534811:30-12:30\uFF0C\u4E0B\u534817:00-19:00\u662F\u4E0D\u5B89\u6392\u5DE5\u4F5C\u7684\uFF0C\u7EA6\u5B9A\u4FD7\u6210\u7684\u5403\u996D\u65F6\u95F4\u3002\u4E0D\u8FC7\u6211\u4E5F\u662F\u540E\u6765\u624D\u77E5\u9053\uFF0C\u5176\u5B9E\u4E94\u70B9\u4E4B\u540E\u90FD\u7B97\u52A0\u73ED\uFF0C\u867D\u7136\u4E03\u70B9\u949F\u786E\u5B9E\u4E5F\u5076\u5C14\u4F1A\u6709\u5F00\u4F1A\uFF0C\u4E0D\u8FC7\u77F3\u6839\u53EA\u662F\u627E\u7406\u7531\u4E0D\u56DE\u5BB6\u7F62\u4E86\u2026\u2026\n\u56E0\u4E3A\u4ED6\u4EEC\u516C\u53F8\u6CA1\u6709\u98DF\u5802\uFF0C\u6240\u4EE5\u5403\u996D\u65F6\u95F4\u5458\u5DE5\u4F1A\u51FA\u6765\u3002\u4E2D\u5348\u7684\u8BDD\uFF0C\u6211\u7ED9\u4ED6\u51C6\u5907\u4E86\u4FBF\u5F53\uFF0C\u4ED6\u5E94\u8BE5\u4E0D\u4F1A\u51FA\u6765\uFF0C\u6211\u53EA\u597D\u665A\u4E0A\u6765\u7B49\u4ED6\u4E86\u3002\n"
      nextNodeId: 
