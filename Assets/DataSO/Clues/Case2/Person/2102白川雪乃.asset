  isAttackContentUnlocked: 0
  showAttackContentDirectly: 1
  attackUnlockContent: 
  summary: "\u59D3\u540D\uFF1A\u767D\u5DDD\u96EA\u4E43\r\n\u72B6\u6001\uFF1A\u5076\u50CF\u827A\u4EBA\r\n\u5929\u5DDD\u6F14\u827A\u65D7\u4E0B\u5076\u50CF\u56E2\u4F53\u661F\u9022\u6210\u5458\u4E4B\u4E00\uFF0C\u6D3B\u52A8\u3001\u901A\u544A\u7B49\u5076\u50CF\u76F8\u5173\u4E8B\u5B9C\u7531\u53D7\u5BB3\u4EBA\u8D1F\u8D23\u3002\u6A58\u65E5\u5411\u7684\u540E\u8F88\u53CA\u961F\u53CB\u3002"
  detailText: 
  Detail_Mark: "[\u7ED3\u679C]\uFF1A\u547D\u4E2D\u8BB0\u5F555468\u6761\u3002\u6309\u5173\u8054\u5EA6\u4E0E\u53EF\u4FE1\u5EA6\u6574\u5408\u3002\r\n\r\n\u3010\u57FA\u672C\u4FE1\u606F\u6458\u8981\u3011\r\n\u6570\u636E\u5C42\u6765\u6E90\uFF1A\u6237\u7C4D\u767B\u8BB0\u7CFB\u7EDF\u3001\u5929\u5DDD\u6F14\u827A\u4E8B\u52A1\u6240\u4EBA\u4E8B\u90E8\u7535\u5B50\u6863\u6848\r\n\u59D3\u540D\uFF1A\u767D\u5DDD \u96EA\u4E43\r\n\u5E74\u9F84\uFF1A20\u5C81\r\n\u804C\u4F4D\uFF1A\u5076\u50CF\u56E2\u4F53\u661F\u9022\u961F\u957F\r\n\u51FA\u9053\u65F6\u95F4\uFF1A2052\u5E74\r\n\r\n\u3010\u5DE5\u4F5C\u5C65\u5386\u3011\r\n2050-2052\uFF0C\u5730\u4E0B\u5076\u50CF\u56E2\u4F53\u300C\u96EA\u6708\u82B1\u300D\u6210\u5458\uFF0C\u4EE3\u8868\u66F2\u300A\u5341\u516D\u591C\u300B\r\n2052\u5E74\uFF0C\u4EE5\u5076\u50CF\u56E2\u4F53\u300C\u661F\u9022\u300D\u961F\u957F\u7684\u8EAB\u4EFD\u51FA\u9053\r\n2052-2053\uFF0C\u65A9\u83B7\u591A\u9879\u5956\u9879\u65B0\u4EBA\u8D4F\u3002\r\n2053-2055\uFF0C\u9996\u5F20\u4E13\u8F91\u300A\u661F\u9022\u7269\u8A9E\u300B\u516C\u4FE1\u699C\u9996\u4F4D\uFF0C\u9500\u91CF40\u4E07\u679A\uFF1B\u7B2C\u4E8C\u5F20\u4E13\u8F91\u300A\u5929\u5DDD\u5F7C\u5CB8\u300B\u518D\u83B7\u5468\u699C\u9996\u4F4D\uFF0C\u9500\u91CF52\u4E07\u679A\r\n2055\u5E74\u81F3\u4ECA\uFF0C\u4E9A\u6D32\u5DE1\u6F14\r\n\r\n\u3010\u5386\u53F2\u4FE1\u606F\u3011\r\n\u6765\u6E90\uFF1A\u5929\u5DDD\u6F14\u827A\u5B98\u7F51\r\n\u767D\u5DDD\u96EA\u4E43\u4E8E2052\u5E74\u4EE516\u5C81\u901A\u8FC7\u7504\u9009\u52A0\u5165\u300C\u661F\u9022\u300D\u3002\u56E2\u4F53\u53D1\u884C\u51FA\u9053\u5355\u66F2\u300A\u5929\u6CB3\u5411\u5CB8\u300B\uFF0C\u9996\u5468\u516C\u4FE1\u699C\u9996\u4F4D\uFF0C\u9500\u91CF23.4\u4E07\u679A\u30022053\u5E74\u56E2\u4F53\u83B7\u65E5\u672C\u9EC4\u91D1\u5927\u8D4F\u65B0\u4EBA\u8D4F\u30022055\u5E74\u9996\u6B21\u4E9A\u6D32\u5DE1\u4E1A\uFF08\u4E1C\u4EAC\u00B7\u9996\u5C14\u00B7\u53F0\u5317\u00B7\u66FC\u8C37\u00B7\u65B0\u52A0\u5761\uFF09\u52A8\u54588\u4E07\u4EBA\uFF0C\u793E\u5185\u79F0\u201C\u5929\u5DDD\u5947\u8FF9\u201D\u3002"
  portrait: {fileID: 21300000, guid: 9d9a30df1acdf9740a54f85a7664a035, type: 3}
  canBeSummoned: 1
  baseDialogues:
  - nodeId: 1
    text: "\u60A8\u597D\uFF0C\u8B66\u63A2\u5148\u751F\uFF0C\u6211\u53EB\u767D\u5DDD\u96EA\u4E43\uFF0C\u661F\u9022\u7684\u6210\u5458\uFF0C\u6A58\u524D\u8F88\u7684\u961F\u53CB\uFF0C\u9AD8\u5CF0\u5148\u751F\u624B\u4E0B\u7684\u827A\u4EBA\u2026\u2026\u4E0D\u3001\u4E0D\u7528\u8BF4\u8FD9\u4E9B\u5417\uFF1F\u62B1\u6B49\u2026\u2026\u60A8\u60F3\u95EE\u4EC0\u4E48\u5C31\u95EE\u5427\u2026\u2026"
    nextNodeId: 
    options:
    - optionId: "\u8B66\u65B9\u9700\u8981\u60A8\u914D\u5408\u8C03\u67E5\u3002"
      optionText: "\u8B66\u65B9\u9700\u8981\u60A8\u914D\u5408\u8C03\u67E5\u3002"
      nextNodeId: 2
  - nodeId: 2
    text: "\u662F\u2026\u2026\u662F\u7684\uFF0C\u8BF7\u95EE\uFF0C\u4ED6\u5230\u5E95\u662F\u600E\u4E48\u6B7B\u7684\u5462\uFF1F"
    nextNodeId: 
    options:
    - optionId: "\u65E0\u6CD5\u900F\u9732\u5C38\u68C0\u62A5\u544A\u3002"
      optionText: "\u65E0\u6CD5\u900F\u9732\u5C38\u68C0\u62A5\u544A\u3002"
      nextNodeId: 3
  - nodeId: 3
    text: "\u2026\u2026\u65E2\u7136\u5982\u6B64\uFF0C\u4E5F\u4E0D\u5FC5\u591A\u8A00\u4E86\u3002\u6211\u2026\u2026\u6211\u613F\u610F\u81EA\u9996\u3002\u662F\u6211\u6740\u6B7B\u4E86\u4ED6\u3002"
    nextNodeId: 
    options:
    - optionId: "\u60A8\u662F\u51FA\u4E8E\u4EC0\u4E48\u52A8\u673A\uFF1F"
      optionText: "\u60A8\u662F\u51FA\u4E8E\u4EC0\u4E48\u52A8\u673A\uFF1F"
      nextNodeId: 4
  - nodeId: 4
    text: "\u4ED6\u6BC1\u4E86\u6211\u7F8E\u597D\u7684\u4E00\u5207\u2026\u2026\u6211\u6709\u4E00\u4E2A\u7537\u670B\u53CB\uFF0C\u53EB\u6850\u751F\u83B2\u3002\u56E0\u4E3A\u6211\u662F\u5076\u50CF\uFF0C\u6709\u7537\u670B\u53CB\u8FD9\u6837\u7684\u4E8B\u60C5\u662F\u4E0D\u53EF\u4EE5\u516C\u5F00\u7684\uFF0C\u4E00\u76F4\u4EE5\u6765\u6211\u4EEC\u90FD\u5C0F\u5FC3\u7FFC\u7FFC\u2026\u2026\u4F46\u662F\uFF0C\u4ED6\u5C45\u7136\u7528\u83B2\u548C\u6211\u4EB2\u543B\u7684\u7167\u7247\u5A01\u80C1\u6211\uFF01"
    nextNodeId: 5
    options: []
  - nodeId: 5
    text: "\u4E03\u5915\u8282\u90A3\u5929\u5F00\u59CB\uFF0C\u4ED6\u5C31\u5F3A\u8FEB\u6211\u548C\u4ED6\u2026\u2026\u5C31\u5728\u6628\u5929\u4E0B\u53482\u70B9\uFF0C\u4ED6\u8FD8\u5F3A\u884C\u8981\u6C42\u6211\u8DDF\u4ED6\u53BB\u536B\u751F\u95F4\u3002\u5982\u679C\u6211\u4E0D\u987A\u4ECE\uFF0C\u4ED6\u5C31\u516C\u5F00\u8FD9\u5F20\u7167\u7247\uFF0C\u5230\u90A3\u65F6\u6211\u7684\u4E8B\u4E1A\u548C\u83B2\u5E73\u9759\u7684\u751F\u6D3B\u5C31\u90FD\u5B8C\u4E86\u2026\u2026\u4E3A\u4E86\u83B2\uFF0C\u6211\u7B54\u5E94\u4E86\uFF0C\u6761\u4EF6\u662F\u628A\u7167\u7247\u4EA4\u7ED9\u6211\u3002"
    nextNodeId: 0
    options:
    - optionId: "\u8BF7\u95EE\u60A8\u4EC0\u4E48\u65F6\u5019\u52A8\u7684\u624B\uFF1F"
      optionText: "\u8BF7\u95EE\u60A8\u4EC0\u4E48\u65F6\u5019\u52A8\u7684\u624B\uFF1F"
      nextNodeId: 6
  - nodeId: 6
    text: "\u4ED6\u6628\u5929\u4E94\u70B9\u5341\u5206\u7684\u65F6\u5019\u56DE\u5230\u4F11\u606F\u5BA4\uFF0C\u628A\u6A58\u524D\u8F88\u53EB\u8D70\u4E86\uFF0C\u800C\u6211\u8D81\u7740\u4ED6\u5355\u72EC\u53EB\u8D70\u6A58\u524D\u8F88\u7684\u65F6\u5019\u52A8\u624B\u7684\uFF0C\u5927\u7EA6\u662F\u665A\u4E0A\u4E94\u70B9\u5341\u4E00\u5DE6\u53F3\u2026\u2026\u6211\u5728\u7C89\u4E1D\u9001\u7684\u793C\u7269\u70B9\u5FC3\u4E0A\u6492\u4E0A\u4E86\u4E0D\u5BB9\u6613\u88AB\u5403\u51FA\u6765\u7684\u82B1\u751F\u7C89\u3002"
    nextNodeId: 7
    options: []
  - nodeId: 7
    text: "\u57FA\u672C\u6BCF\u6B21\u6F14\u51FA\u90FD\u4F1A\u6709\u793C\u7269\uFF0C\u4F46\u56E0\u4E3A\u8C01\u4E5F\u4E0D\u77E5\u9053\u4F1A\u4E0D\u4F1A\u6709\u4EBA\u6076\u4F5C\u5267\u6216\u8005\u9ED1\u7C89\u9001\u6709\u6BD2\u7684\u4E1C\u897F\uFF0C\u6240\u4EE5\u4E0D\u4F1A\u6709\u4EBA\u5403\u8FD9\u4E9B\u3002\u9664\u4E86\u9AD8\u5CF0\uFF0C\u4ED6\u662F\u4E2A\u2026\u2026\u7231\u8D2A\u5C0F\u4FBF\u5B9C\u7684\u4EBA\u3002\u52A0\u4E0A\u4ED6\u66FE\u544A\u8BC9\u6211\u4ED6\u5BF9\u82B1\u751F\u8FC7\u654F\u2026\u2026"
    nextNodeId: 
    options: []
  fallbackDialogues:
  - nodeId: 35
    text: "\u62B1\u6B49\u2026\u2026\u6211\u4E0D\u592A\u660E\u767D\u60A8\u60F3\u95EE\u4EC0\u4E48\u3002"
