  - shownClue: {fileID: 11400000, guid: 1b1049098f6931c45969f49399b28c49, type: 2}
    dialogues:
    - nodeId: 18
      text: "\u51AC\u9A6C\u7ECF\u7406\u5F53\u7136\u4E5F\u662F\u6211\u7684\u719F\u4EBA\u4E86\uFF01\u867D\u7136\u6211\u4EEC\u5728\u4E1A\u52A1\u4E0A\u6CA1\u6709\u4EC0\u4E48\u5173\u7CFB\uFF0C\u4E0D\u8FC7\u56E0\u4E3A\u4ED6\u4EEC\u516C\u53F8\u95E8\u7981\u7684\u7F18\u6545\uFF0C\u6BD5\u7ADF\u51AC\u9A6C\u7ECF\u7406\u548C\u5176\u4ED6\u666E\u901A\u5458\u5DE5\u4E00\u6837\u90FD\u5728\u529E\u516C\u533A\u57DF\u529E\u516C\u561B\uFF0C\u4ED6\u6765\u7ED9\u6211\u5F00\u95E8\u7684\u6B21\u6570\u6BD4\u8F83\u591A\u4E00\u4E9B\u3002"
      nextNodeId: 19
      options: []
    - nodeId: 19
      text: "\u8FD9\u5BB6\u4F19\u548C\u677E\u4E95\u5148\u751F\u4F3C\u4E4E\u4E0D\u662F\u5F88\u5408\u5F97\u6765\u7684\u6837\u5B50\uFF0C\u4E5F\u4E0D\u77E5\u9053\u4E3A\u4EC0\u4E48\uFF0C\u6BCF\u6B21\u89C1\u5230\u6211\u90FD\u4F1A\u6253\u542C\u4E00\u4E0B\u6700\u8FD1\u548C\u677E\u4E95\u5148\u751F\u8C08\u9879\u76EE\u987A\u4E0D\u987A\u5229\uFF0C\u8FD8\u5BF9\u6211\u6324\u7709\u5F04\u773C\u7684\uFF0C\u6709\u4E9B\u5947\u602A\u3002\u6211\u53C8\u4E0D\u662F\u4ED6\u5E73\u65F6\u52FE\u52FE\u642D\u642D\u7684\u90A3\u4E9B\u5C0F\u59D1\u5A18\uFF0C\u5E72\u561B\u5BF9\u6211\u8868\u60C5\u90A3\u4E48\u4E30\u5BCC\u554A\uFF01"
