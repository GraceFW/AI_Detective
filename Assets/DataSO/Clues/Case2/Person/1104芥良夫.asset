  - shownClue: {fileID: 11400000, guid: 8b338377abe23e14d87780ff857ce5d7, type: 2}
    dialogues:
    - nodeId: 15
      text: "\u4F60\u662F\u8BF4\u6211\u548C\u677E\u4E95\u77F3\u6839\u7684\u5173\u7CFB\u554A\u3002\u512A\u54C1\u5802\u516C\u53F8\u53EF\u662F\u6211\u7684\u5927\u5BA2\u6237\u3002\u8FD9\u5355\u8C08\u7684\u4E5F\u4E0D\u5BB9\u6613\u5462\u3002\u672C\u6765\u4ED6\u4EEC\u8C08\u7684\u662F\u53E6\u4E00\u5BB6\u5382\u5B50\uFF0C\u4EF7\u683C\u8FD8\u8981\u66F4\u4F4E\uFF0C\u4E0D\u8FC7\u554A\uFF0C\u6211\u6253\u542C\u5230\u677E\u4E95\u5148\u751F\u6709\u4E2A\u7231\u597D\uFF0C\u662F\u6253\u5C0F\u94A2\u73E0\u3002\u6211\u5C31\u966A\u4ED6\u4E00\u8D77\u53BB\u5E97\u91CC\uFF0C\u8FD8\u7ED9\u4ED6\u4ECB\u7ECD\u9644\u8FD1\u4EF7\u683C\u66F4\u516C\u9053\uFF0C\u6548\u679C\u66F4\u534E\u4E3D\u7684\u5E97\u5BB6\u3002"
      nextNodeId: 16
      options: []
    - nodeId: 16
      text: "\u6B38\uFF0C\u8FD9\u4E48\u4E00\u6765\u4E8C\u53BB\uFF0C\u6211\u4EEC\u5C31\u6DF7\u719F\u4E86\uFF0C\u4E1A\u52A1\u81EA\u7136\u5C31\u597D\u8C08\uFF0C\u5F88\u5FEB\u5C31\u8C08\u6210\u4E86\u4E00\u4E2A\u5927\u5355\u5B50\u3002\u540E\u9762\u6211\u4EEC\u5C31\u5F62\u6210\u7A33\u5B9A\u5408\u4F5C\u4E86\u3002\u8FD9\u6B21\u662F\u4E0A\u4E0A\u5468\u4E94\u7684\u5355\u5B50\u6709\u70B9\u758F\u6F0F\uFF0C\u6240\u4EE5\u624D\u6765\u627E\u4ED6\u7684\u3002"
      nextNodeId: 
      options:
