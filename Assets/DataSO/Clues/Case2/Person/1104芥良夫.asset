  isAttackContentUnlocked: 0
  showAttackContentDirectly: 1
  attackUnlockContent: 
  summary: "\u59D3\u540D\uFF1A\u82A5\u826F\u592B\r\n\u72B6\u6001\uFF1A\u672C\u95F4\u7EB8\u696D\u9500\u552E\u3002\u4E1A\u7EE9\u4F18\u79C0\uFF0C\u5E38\u5F00\u5927\u5355\uFF0C\u522B\u4EBA\u5F00\u4E0D\u51FA\u7684\u5355\u5B50\u4ED6\u80FD\u5F00\uFF0C\u662F\u516C\u53F8\u7684\u91D1\u724C\u9500\u552E\u3002"
  detailText: 
  Detail_Mark: "[\u7ED3\u679C]\uFF1A\u547D\u4E2D\u8BB0\u5F55150\u6761\u3002\u6309\u5173\u8054\u5EA6\u4E0E\u53EF\u4FE1\u5EA6\u6574\u5408\u3002\r\n\r\n\u3010\u57FA\u672C\u4FE1\u606F\u6458\u8981\u3011\r\n\u6570\u636E\u5C42\u6765\u6E90\uFF1A\u6237\u7C4D\u767B\u8BB0\u7CFB\u7EDF\u3001\u672C\u95F4\u7EB8\u696D\u4EBA\u4E8B\u90E8\u7535\u5B50\u6863\u6848\r\n\u59D3\u540D\uFF1A\u82A5
    \u826F\u592B\r\n\u5E74\u9F84\uFF1A42\u5C81\r\n\u804C\u4F4D\uFF1A\u672C\u95F4\u7EB8\u696D\u9500\u552E\u5458\r\n\u5A5A\u59FB\u72B6\u6001\uFF1A\u5DF2\u5A5A\r\n\u5B66\u5386\uFF1A2040\u5E74\u83B7\u65E9\u7A3B\u7530\u5927\u5B66\u5B66\u58EB\u5B66\u4F4D\r\n\r\n\u3010\u5DE5\u4F5C\u5C65\u5386\u3011\r\n2040\u5E74-2044\u5E74\uFF0C\u5F80\u65F6\u88FD\u7EB8\u4E1A\u52A1\u90E8\uFF0C\u666E\u901A\u5458\u5DE5\r\n2045\u5E74-2048\u5E74\uFF0C\u5F80\u65F6\u88FD\u7EB8\u4E1A\u52A1\u90E8\uFF0C\u7ECF\u7406\r\n2048\u5E74-2052\u5E74\uFF0C\u5F80\u65F6\u88FD\u7EB8\u4E1A\u52A1\u90E8\uFF0C\u90E8\u957F\r\n2052\u5E74-2053\u5E74\uFF0C\u65E0\r\n2053\u5E74\u81F3\u4ECA\uFF0C\u672C\u95F4\u7EB8\u696D\u4E1A\u52A1\u90E8\r\n\r\n\u3010\u52A8\u6001\u4FE1\u606F\u3011\r\n\u6765\u6E90\uFF1A\u65E9\u7A3B\u7530\u5927\u5B66\u5B98\u7F51\r\n\u82A5\u826F\u592B\u4E3A\u65E9\u7A3B\u7530\u5927\u5B662040\u5C4A\u4F18\u79C0\u6BD5\u4E1A\u751F\r\n\r\n\u3010\u76F8\u5173\u5185\u5BB9\u3011\r\n\u6765\u6E90\uFF1A\u5F80\u65F6\u88FD\u7EB8\u5B98\u7F51\u3001\u62DB\u8058\u7F51\u7AD9\r\n\u5F80\u65F6\u88FD\u7EB8\u5728\u56FD\u5185\u4E3A\u9020\u7EB8\u5934\u90E8\u54C1\u724C\uFF0C\u4E24\u767E\u4F59\u5E74\u7684\u60A0\u4E45\u5386\u53F2\u4F53\u73B0\u4E86\u8BE5\u516C\u53F8\u5728\u4E1A\u52A1\u4E0A\u7684\u5B89\u5168\u3001\u53EF\u9760\uFF0C\u503C\u5F97\u4FE1\u4EFB\uFF1B\u5728\u62DB\u8058\u5F53\u4E2D\u901A\u5E38\u62DB\u6536\u540D\u724C\u5927\u5B66\u7684\u4F18\u79C0\u5B66\u751F\uFF0C\u7531\u4E8E\u85AA\u8D44\u5F85\u9047\u597D\uFF0C\u798F\u5229\u9AD8\uFF0C\u5927\u91CF\u4EBA\u624D\u8D8B\u4E4B\u82E5\u9E5C\u3002\r\n\u6765\u6E90\uFF1A\u7F51\u7EDC\u8BBA\u575B\u3001\u6C42\u804C\u7F51\u7AD9\r\n\u5F80\u65F6\u88FD\u7EB8\u770B\u91CD\u5458\u5DE5\u7684\u521B\u9020\u529B\u548C\u594B\u6597\u7CBE\u795E\uFF0C\u504F\u597D\u5E74\u8F7B\u5458\u5DE5\uFF0C\u5728\u5584\u5F85\u8001\u5458\u5DE5\u65B9\u9762\u6709\u6240\u4E0D\u8DB3\u3002\u5982\u679C\u5728\u5355\u4F4D\u4E1A\u7EE9\u4E0B\u6ED1\u660E\u663E\uFF0C\u4E0D\u8BBA\u5E74\u8D44\u5982\u4F55\u90FD\u53EF\u80FD\u906D\u9047\u5F00\u9664\u3002"
  portrait: {fileID: 21300000, guid: 53fcaaf16e846c14983867db0a00114c, type: 3}
  canBeSummoned: 1
  baseDialogues:
  - nodeId: 1
    text: "\u4F60\uFF0C\u4F60\u662F\u4EC0\u4E48\u4E1C\u897F\u554A\uFF1F\u4E3A\u4EC0\u4E48\u628A\u6211\u5E26\u5230\u8FD9\u91CC\u6765\uFF1F"
    nextNodeId: 
    options:
    - optionId: "\u81EA\u6211\u4ECB\u7ECD"
      optionText: "\u81EA\u6211\u4ECB\u7ECD"
      nextNodeId: 2
  - nodeId: 2
    text: "\u8FD9\u6837\u554A\u2014\u2014\u4E0D\u597D\u610F\u601D\u554A\uFF0C\u5DE5\u85E4\u8B66\u5B98\u3002\u4F60\u662F\u6765\u67E5\u677E\u4E95\u77F3\u6839\u7684\u6B7B\u56E0\u7684\uFF1F\u6211\u53EF\u6CA1\u6740\u4ED6\uFF01"
    nextNodeId: 
    options:
    - optionId: "\u8BF7\u89E3\u91CA\u4E00\u4E0B\u60A8\u5F53\u5929\u7684\u884C\u7A0B"
      optionText: "\u8BF7\u89E3\u91CA\u4E00\u4E0B\u60A8\u5F53\u5929\u7684\u884C\u7A0B"
      nextNodeId: 3
  - nodeId: 3
    text: "\u6211\u5C31\u77E5\u9053\uFF01\u679C\u7136\u4F1A\u60F9\u4E0A\u9EBB\u70E6\u3002\u542C\u6211\u89E3\u91CA\uFF0C\u5DE5\u85E4\u8B66\u5B98\u3002\u6211\u5F53\u5929\u5C31\u662F\u6B63\u5E38\u5DE5\u4F5C\u3002\u7136\u540E\u56E0\u4E3A\u4E4B\u524D\u7684\u5408\u4F5C\u51FA\u4E86\u4E9B\u95EE\u9898\uFF0C\u6240\u4EE5\u5728\u4E94\u70B920\u2026\u2026\u5443\uFF0C\u6211\u770B\u4E00\u4E0B\u77ED\u4FE1\uFF0C\u54E6\uFF0117:25\u7684\u65F6\u5019\uFF0C\u6211\u4F20\u4E86\u6D88\u606F\u7ED9\u677E\u4E95\u90E8\u957F\u7EA6\u89C1\uFF0C\u4ED6\u540C\u610F\u4E86\u3002\u7ED3\u679C\u6211\u5341\u5206\u949F\u4E4B\u540E\u5230\u7684\u65F6\u5019\uFF0C\u4ED6\u53C8\u4E0D\u56DE\u6211\u4E86\u3002\u4ED6\u4EEC\u516C\u53F8\u8FDB\u95E8\u9EBB\u70E6\u7684\u8981\u547D\uFF0C\u697C\u4E0B\u95E8\u7981\u5F88\u4E25\uFF0C\u6211\u5C31\u5728\u697C\u4E0B\u7B49\u4E86\u4E00\u4F1A\u513F\uFF0C\u60F3\u7B49\u4ED6\u56DE\u590D\u518D\u4E0A\u53BB\u3002\n\u554A\uFF0C\u6211\u8FD8\u78B0\u5230\u4E00\u4F4D\u7F8E\u5973\u6765\u7740\uFF01\u6211\u548C\u5979\u642D\u8BAA\uFF0C\u5979\u8BF4\u662F\u6765\u7B49\u4E08\u592B\u4E0B\u73ED\u7684\uFF0C\u8FD9\u4E9B\u697C\u4E0B\u76D1\u63A7\u91CC\u80AF\u5B9A\u90FD\u80FD\u770B\u5230\uFF01"
    nextNodeId: 4
    options: []
  - nodeId: 4
    text: "\u7ED3\u679C\u6211\u7B49\u4E86\u4E94\u5206\u949F\u90FD\u6CA1\u53CD\u5E94\uFF0C\u6211\u6709\u70B9\u7B49\u6025\u4E86\uFF0C\u5C31\u76F4\u63A5\u6253\u4E86\u4ED6\u4EEC\u516C\u53F8\u7684\u7535\u8BDD\uFF0C\u56E0\u4E3A\u662F\u5408\u4F5C\u8FC7\u7684\u516C\u53F8\u6240\u4EE5\u4E5F\u5F00\u4E86\u95E8\uFF0C\u6211\u5C31\u4E0A\u53BB\u627E\u4ED6\u3002\n\u4E0A\u53BB\u4E4B\u540E\u6211\u60F3\u76F4\u63A5\u53BB\u4ED6\u529E\u516C\u5BA4\uFF0C\u7ED3\u679C\u53D1\u73B0\u95E8\u6253\u4E0D\u5F00\uFF0C\u5E94\u8BE5\u662F\u9501\u4F4F\u4E86\u3002\u4F46\u662F\u6211\u53C8\u6B63\u597D\u78B0\u5230\u4ED6\u4EEC\u90E8\u95E8\u7684\u51AC\u9A6C\u7ECF\u7406\uFF0C\u4ED6\u548C\u6211\u8BF4\u677E\u4E95\u90E8\u957F\u53EF\u80FD\u4E34\u65F6\u6709\u4E8B\u51FA\u53BB\u4E86\uFF0C\u6211\u5C31\u60F3\u7740\u7B49\u7B49\u4ED6\u2026\u2026"
    nextNodeId: 5
    options: []
  - nodeId: 5
    text: "\u7B2C\u4E8C\u6B21\u6765\uFF0C\u95E8\u5F00\u7740\u4E00\u6761\u5C0F\u7F1D\uFF0C\u6211\u5C31\u63A8\u95E8\u8FDB\u53BB\u4E86\u3002\u7ED3\u679C\u4E00\u8FDB\u53BB\u53D1\u73B0\u4ED6\u5DF2\u7ECF\u6B7B\u4E86\uFF01\u5413\u6211\u4E00\u8DF3\uFF0C\u6211\u751F\u6015\u60F9\u4E0A\u9EBB\u70E6\uFF0C\u8D76\u7D27\u8DD1\u4E86\u3002\u8B66\u5B98\uFF0C\u770B\u76D1\u63A7\u4E5F\u80FD\u770B\u51FA\u6765\uFF0C\u6211\u6839\u672C\u5C31\u6CA1\u6709\u6740\u4EBA\u7684\u65F6\u95F4\u3002\u6211\u53EA\u662F\u5413\u574F\u4E86\u6015\u60F9\u9EBB\u70E6\u6CA1\u6709\u62A5\u8B66\uFF0C\u8FD9\u53EF\u6CA1\u6709\u72AF\u7F6A\uFF0C\u4F60\u4E0D\u80FD\u6293\u6211\u554A\uFF01"
    nextNodeId: 
    options: []
  fallbackDialogues:
  - nodeId: 32
    text: "\u554A\uFF1F\u6211\u4E0D\u77E5\u9053\u554A\u3002\u8FD9\u4E2A\u6211\u4E0D\u6E05\u695A\uFF0C\u8FD8\u662F\u8D76\u7D27\u95EE\u5B8C\u4E4B\u540E\u653E\u6211\u4EEC\u56DE\u53BB\u5427\uFF0C\u8B66\u5B98\uFF0C\u6211\u660E\u5929\u8FD8\u6709\u751F\u610F\u8981\u8C08\u3002"
    nextNodeId: 
    options: []
  clueDialogues:
  - shownClue: {fileID: 11400000, guid: a78353470b7c1a84d9f7c109fea30633, type: 2}
    dialogues:
    - nodeId: 6
      text: "\u5443\uFF0C\u662F\u7684\uFF0C\u56FE\u4E0A\u7684\u4EBA\u662F\u6211\u3002\u4F46\u662F\u8FD9\u548C\u4ED6\u7684\u6B7B\u6CA1\u5173\u7CFB\u554A\uFF01\u6211\u5F53\u65F6\u770B\u7740\u4ED6\u4E0D\u5728\uFF0C\u8FD9\u6B21\u7684\u4E1A\u52A1\u53C8\u6BD4\u8F83\u6025\uFF0C\u5C31\u60F3\u7740\u8D76\u7D27\u53BB\u6863\u6848\u5BA4\u627E\u4E00\u4E0B\u4E0A\u6B21\u7B7E\u7684\u5408\u540C\u548C\u53D1\u7968\u4E4B\u7C7B\u7684\uFF0C\u8FD9\u6837\u627E\u5230\u4ED6\u4E5F\u80FD\u76F4\u63A5\u5904\u7406\u5B8C\u3002"
      nextNodeId: 7
      options: []
    - nodeId: 7
      text: "\u4F46\u662F\u6211\u4E0D\u592A\u719F\u6089\u4ED6\u4EEC\u516C\u53F8\uFF0C\u6CA1\u627E\u5230\uFF0C\u5C31\u60F3\u7740\u4ED6\u8981\u662F\u51FA\u95E8\u4E86\u4E5F\u8BE5\u56DE\u6765\u4E86\u3002\u7ED3\u679C\u4E00\u56DE\u53BB\uFF0C\u95E8\u662F\u5F00\u7740\uFF0C\u4F46\u4EBA\u65E9\u5C31\u6B7B\u4E86\uFF0C\u6211\u5413\u5F97\u76F4\u63A5\u8DD1\u4E86\u2026\u2026\u6BD5\u7ADF\u8981\u662F\u88AB\u53D1\u73B0\u4E86\uFF0C\u6211\u4F5C\u4E3A\u5916\u4EBA\u80AF\u5B9A\u8BB2\u4E0D\u6E05\u695A\uFF01\u6211\u771F\u7684\u6CA1\u6740\u4EBA\uFF01"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: b6fd833f078c79344b8eb7882cc1b623, type: 2}
    dialogues:
    - nodeId: 8
      text: "\u54E6\uFF0C\u5929\u54EA\uFF0C\u8FD9\u662F\u6211\u7684\u5305\uFF01\u4F60\u4EEC\u662F\u5728\u54EA\u91CC\u627E\u5230\u7684\uFF1F\u6211\u8FD8\u4EE5\u4E3A\u6211\u843D\u5728\u8F66\u4E0A\u2014\u2014\u677E\u4E95\u77F3\u6839\u7684\u529E\u516C\u5BA4\uFF1F\u54E6\uFF0C\u54E6\u5BF9\u4E86\uFF01\u662F\u6709\u90A3\u4E48\u4E00\u56DE\u4E8B\uFF0C\u6211\u5F53\u65F6\u53D1\u73B0\u4ED6\u6B7B\u4E86\uFF0C\u5929\u5450\uFF0C\u90A3\u573A\u9762\u5413\u6B7B\u4EBA\u4E86\uFF0C\u8111\u888B\u51F9\u4E0B\u53BB\u4E00\u5927\u5757\uFF0C\u8840\u8FD8\u5728\u6EF4\u6EF4\u7B54\u7B54\u5F80\u88E4\u5B50\u4E0A\u6EF4\u5462\uFF01\u7B80\u76F4\u628A\u6211\u5413\u574F\u4E86\uFF0C\u6211\u53C8\u2026\u2026"
      nextNodeId: 9
      options: []
    - nodeId: 9
      text: "\u5BF9\uFF0C\u5BF9\uFF01\u6211\u521A\u624D\u5FD8\u8BB0\u8BF4\u4E86\uFF0C\u6211\u5F53\u65F6\u542C\u5230\u80CC\u540E\u6709\u811A\u6B65\u58F0\uFF0C\u53EF\u5413\u6B7B\u6211\u4E86\uFF01\u6211\u751F\u6015\u6211\u5E26\u7740\u94B1\u88AB\u8BEF\u4EE5\u4E3A\u662F\u6740\u4EBA\u51F6\u624B\uFF0C\u5C31\u8D76\u7D27\u8DD1\u4E86\uFF0C\u4E00\u5B9A\u662F\u5F53\u65F6\u843D\u4E0B\u7684\u3002\u60A8\u53EF\u5343\u4E07\u641E\u6E05\u695A\u554A\uFF0C\u770B\u76D1\u63A7\u4E5F\u77E5\u9053\u6211\u6CA1\u6709\u8BF4\u8C0E\uFF01\u6211\u53EF\u662F\u53EA\u5728\u91CC\u9762\u5446\u4E86\u534A\u5206\u949F\u4E0D\u5230\u5C31\u88AB\u5413\u8DD1\u4E86\uFF01"
      nextNodeId: 
      options:
      - optionId: "\u80CC\u540E\u6709\u811A\u6B65\u58F0\uFF1F"
        optionText: "\u80CC\u540E\u6709\u811A\u6B65\u58F0\uFF1F"
        nextNodeId: 10
      - optionId: "\u4E3A\u4EC0\u4E48\u4F1A\u643A\u5E26\u5927\u989D\u73B0\u91D1"
        optionText: "\u4E3A\u4EC0\u4E48\u4F1A\u643A\u5E26\u5927\u989D\u73B0\u91D1"
        nextNodeId: 11
    - nodeId: 10
      text: "\u5BF9\u5BF9\u5BF9\uFF0C\u597D\u50CF\u6709\u4EC0\u4E48\u4EBA\u8FC7\u6765\u4E86\uFF0C\u6211\u751F\u6015\u88AB\u53D1\u73B0\u2026\u2026\u8FD9\uFF0C\u8FD9\uFF0C\u6211\u5C31\u7B97\u662F\u518D\u957F\u4E00\u5F20\u5634\u4E5F\u8BF4\u4E0D\u6E05\u695A\u554A\u3002\u65E0\u8BBA\u5982\u4F55\uFF0C\u8FD9\u8DDF\u6211\u53EF\u6CA1\u6709\u5173\u7CFB\u554A\uFF0C\u8B66\u5B98\u3002"
      nextNodeId: 
      options:
      - optionId: "\u8FD9\u79CD\u8BF4\u8F9E\u65E0\u6CD5\u6D17\u6E05\u5ACC\u7591"
        optionText: "\u8FD9\u79CD\u8BF4\u8F9E\u65E0\u6CD5\u6D17\u6E05\u5ACC\u7591"
        nextNodeId: 12
    - nodeId: 11
      text: "\u6211\u2026\u2026\u6211\uFF0C\u5443\uFF0C\u4F60\u77E5\u9053\u7684\uFF0C\u6211\u662F\u4E1A\u52A1\u5458\u561B\uFF0C\u8FD9\u6D41\u7A0B\u4E0A\u51FA\u95EE\u9898\u7684\u65F6\u5019\uFF0C\u5C31\u662F\u9700\u8981\u7528\u94B1\u53BB\u586B\u7684\u2026\u2026\u4E0D\u8BBA\u662F\u4EC0\u4E48\uFF0C\u53CD\u6B63\u548C\u6740\u4EBA\u6848\u6CA1\u5173\u7CFB\u554A\uFF0C\u8B66\u5B98\u3002"
