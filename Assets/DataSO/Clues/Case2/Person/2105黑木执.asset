  clueDialogues:
  - shownClue: {fileID: 11400000, guid: cedbef1b9b00ea342beeb3daec62014c, type: 2}
    dialogues:
    - nodeId: 3
      text: "\u90A3\u4E2A\u773C\u91CC\u53EA\u6709\u94B1\u7684\u4EBA\uFF01\u4E00\u5B9A\u662F\u56E0\u4E3A\u4ED6\uFF0C\u96EA\u4E43\u5C0F\u59D0\u8FD9\u4E9B\u65E5\u5B50\u975E\u5E38\u75B2\u60EB\uFF0C\u4E00\u5B9A\u662F\u56E0\u4E3A\u4ED6\u603B\u662F\u4E0D\u8BA9\u96EA\u4E43\u5C0F\u59D0\u4F11\u606F\uFF0C\u8FD8\u6CA1\u672C\u4E8B\u7ED9\u5979\u66F4\u597D\u7684\u8D44\u6E90\uFF01\u6211\u4E00\u5B9A\u8981\u4ECE\u4ED6\u624B\u4E0A\u4FDD\u62A4\u597D\u96EA\u4E43\u5C0F\u59D0\u7684\u8BF4\uFF01"
      nextNodeId: 
