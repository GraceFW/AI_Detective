  - nodeId: 1
    text: "\u4E0D\u662F\uFF1F\u4F60\u662F\u4EC0\u4E48\u4E1C\u897F\u7684\u8BF4\uFF1F\u6211\u4E3A\u4EC0\u4E48\u8981\u6765\u8B66\u89C6\u5385\u7684\u8BF4\uFF1F"
