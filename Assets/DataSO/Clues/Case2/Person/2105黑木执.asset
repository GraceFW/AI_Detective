    - nodeId: 16
      text: "\u662F\u2026\u2026\u662F\u7684\uFF0C\u56FE\u4E0A\u7684\u4EBA\u662F\u6211\u2026\u2026\u4E0D\u8FC7\u3001\u4E0D\u8FC7\u5DE5\u85E4\u5148\u751F\uFF01\u6211\u505A\u8FD9\u4E00\u5207\u662F\u6709\u539F\u56E0\u7684\uFF0C\u90FD\u662F\u51AC\u9A6C\uFF0C\u90FD\u662F\u51AC\u9A6C\u90A3\u5BB6\u4F19\u2026\u2026\uFF01\u4E0A\u6B21\u677E\u4E95\u90E8\u957F\u7ED9\u6211\u53D1\u4E86\u4E00\u4EFD\u5408\u540C\uFF0C\u8BA9\u6211\u8D70\u6D41\u7A0B\uFF0C\u7ED3\u679C\u6211\u8D70\u5B8C\u6D41\u7A0B\u53D1\u7ED9\u672C\u95F4\u7EB8\u696D\u4E4B\u540E\uFF0C\u51AC\u9A6C\u90A3\u5BB6\u4F19\u5374\u8BF4\u8FD9\u5408\u540C\u7528\u7684\u662F\u79C1\u5370\uFF0C\u6570\u989D\u4E5F\u548C\u4E4B\u524D\u7684\u5DEE\u7684\u5F88\u591A\uFF0C\u8BF4\u6211\u8FD9\u6837\u662F\u91CD\u5927\u5DE5\u4F5C\u5931\u8BEF\u3002"
      nextNodeId: 17
      options: []
    - nodeId: 17
      text: "\u5C3D\u7BA1\u6211\u8BF4\u662F\u677E\u4E95\u90E8\u957F\u7ED9\u6211\u7684\uFF0C\u4ED6\u8FD8\u662F\u8BF4\uFF0C\u6211\u6CA1\u6709\u5BA1\u6838\u5C31\u76F4\u63A5\u7528\u5370\uFF0C\u53D1\u751F\u8FD9\u79CD\u4E8B\u4E5F\u662F\u6709\u6211\u7684\u8D23\u4EFB\uFF0C\u5982\u679C\u7206\u51FA\u6765\u6211\u4E5F\u80AF\u5B9A\u4F1A\u4E22\u5DE5\u4F5C\u2026\u2026\u6211\u3001\u6211\u5BB3\u6015\uFF0C\u5C31\u4E00\u76F4\u542C\u4ED6\u7684\u2026\u2026\u8FD9\u6B21\u6211\u5C31\u60F3\u7740\u53EA\u8981\u627E\u5230\u90A3\u4EFD\u5408\u540C\uFF0C\u7136\u540E\u53BB\u627E\u677E\u4E95\u90E8\u957F\u8BF4\u6E05\u695A\uFF0C\u518D\u4E5F\u4E0D\u8981\u542C\u90A3\u5BB6\u4F19\u7684\u4E86\u2026\u2026"
      nextNodeId: 
      options:
      - optionId: "\u4E3A\u4EC0\u4E48\u677E\u4E95\u77F3\u6839\u5148\u751F\u4F1A\u613F\u610F\u5E2E\u52A9\u60A8\uFF1F"
        optionText: "\u4E3A\u4EC0\u4E48\u677E\u4E95\u77F3\u6839\u5148\u751F\u4F1A\u613F\u610F\u5E2E\u52A9\u60A8\uFF1F"
