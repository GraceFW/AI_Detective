    - nodeId: 19
      text: "\u56E0\u4E3A\uFF0C\u51AC\u9A6C\u90A3\u5BB6\u4F19\u2026\u2026\u51AC\u9A6C\u90A3\u5BB6\u4F19\u8981\u6211\u5E2E\u4ED6\u9690\u7792\u7684\u4E8B\u60C5\uFF0C\u6211\u5B9E\u5728\u662F\u505A\u4E0D\u5230\u4E86\u2026\u2026\u4ED6\uFF0C\u4ED6\u7ADF\u7136\u548C\u90E8\u957F\u7684\u59BB\u5B50\u4E0D\u6E05\u4E0D\u695A\u2026\u2026\u8FD8\u5728\u516C\u53F8\uFF0C\u5728\u8336\u6C34\u95F4\u63A5\u543B\u2026\u2026\uFF01"
