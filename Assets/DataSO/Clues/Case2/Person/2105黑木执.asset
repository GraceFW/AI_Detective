    - nodeId: 12
      text: "\u554A\u5F53\u7136\uFF01\u90A3\u662F\u6211\u7CBE\u5FC3\u4E3A\u96EA\u4E43\u5C0F\u59D0\u51C6\u5907\u7684\u8BF4\uFF01\u6211\u53EF\u662F\u8981\u6210\u4E3A\u4E86\u89E3\u96EA\u4E43\u5C0F\u59D0\u4E00\u5207\u7684\u7537\u4EBA\u554A\uFF01\u5BF9\u8FD9\u91CC\u7684\u6BCF\u4E00\u4E2A\u6444\u50CF\u5934\uFF0C\u6211\u90FD\u4E86\u82E5\u6307\u638C\u7684\u8BF4\uFF01\u6BD4\u5982\u8BF4\uFF0C\u6211\u77E5\u9053\u6709\u4E2A\u80FD\u62CD\u5230\u536B\u751F\u95F4\u548C\u5316\u5986\u5BA4\u7684\u8D70\u5ECA\u6444\u50CF\u5934\uFF0C\u8FD8\u6709\u4F11\u606F\u5BA4\u95E8\u53E3\u7684\u821E\u53F0\u540E\u53F0\u6444\u50CF\u5934\u2026\u2026\u8FD9\u4E2A\u5C0F\u793C\u7269\uFF0C\u662F\u4E13\u95E8\u4E3A\u4E86\u586B\u8865\u6B7B\u89D2\u800C\u51C6\u5907\u7684\u8BF4\uFF01"
