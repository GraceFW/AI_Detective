  - shownClue: {fileID: 11400000, guid: 8b338377abe23e14d87780ff857ce5d7, type: 2}
    dialogues:
    - nodeId: 9
      text: "\u677E\u4E95\u90E8\u957F\u4EBA\u8FD8\u662F\u5F88\u4E0D\u9519\u7684\u2026\u2026\u81EA\u5DF1\u5DE5\u4F5C\u5F88\u89C4\u5F8B\uFF0C\u6BCF\u5929\u4E0B\u73ED\u5F88\u65E9\uFF0C\u6240\u4EE5\u4E5F\u4E0D\u4F1A\u8BA9\u6211\u4EEC\u52A0\u73ED\u2026\u2026\u5E73\u65F6\u6709\u4EC0\u4E48\u4E8B\u60C5\u6211\u4EEC\u90FD\u662F\u53D1\u90AE\u4EF6\u6C9F\u901A\u3002\u6CA1\u60F3\u5230\u4ED6\u6B7B\u7684\u8FD9\u4E48\u7A81\u7136\u3002"
      nextNodeId: 10
      options: []
    - nodeId: 10
      text: "\u4F46\u662F\u2026\u2026\u6211\u4EEC\uFF0C\u6211\u548C\u4ED6\u4E5F\u6CA1\u6709\u4EC0\u4E48\u4EA4\u96C6\uFF0C\u5C31\u662F\uFF0C\u5C31\u662F\u6839\u672C\u4E0D\u600E\u4E48\u4F1A\u5429\u5490\u6211\u5DE5\u4F5C\uFF0C\u6240\u4EE5\uFF0C\u6240\u4EE5\u2026\u2026\u6211\u4E5F\u4E0D\u77E5\u9053\u4E3A\u4EC0\u4E48\u684C\u5B50\u4E0A\u4F1A\u6709\u6211\u7684\u540D\u5B57\uFF0C\u51F6\u624B\u96BE\u9053\u3001\u96BE\u9053\u662F\u4EC0\u4E48\u5996\u9B54\u5417\uFF1F\u80FD\u77E5\u9053\u6211\u63A5\u4E0B\u6765\u8981\u8FDB\u53BB\u770B\u2026\u2026\u6C42\u4F60\uFF0C\u6C42\u4F60\u4E00\u5B9A\u8981\u67E5\u51FA\u771F\u76F8\u2026\u2026\u6211\u6CA1\u6709\u6740\u4EBA\uFF01"
