  - shownClue: {fileID: 11400000, guid: ae4782eb8a2649d45a2a69bf4a516cbd, type: 2}
    dialogues:
    - nodeId: 20
      text: "\u6211\u4ECE\u6863\u6848\u5BA4\u51FA\u6765\u4E4B\u540E\u672C\u6765\u5C31\u6253\u7B97\u76F4\u63A5\u53BB\u627E\u677E\u4E95\u90E8\u957F\u89E3\u91CA\u8FD9\u4EF6\u4E8B\uFF0C\u4F46\u662F\uFF0C\u4F46\u662F\u51FA\u6765\u7684\u65F6\u5019\u6211\u542C\u5230\u90A3\u8FB9\u6709\u811A\u6B65\u58F0\u2026\u2026\u8FD9\u4E8B\u60C5\u6BD5\u7ADF\u4E0D\u5149\u5F69\uFF0C\u800C\u4E14\u6211\u4E5F\u662F\u628A\u5408\u540C\u2026\u2026\u4F60\u77E5\u9053\u7684\uFF0C\u5077\u51FA\u6765\u7684\u2026\u2026\u6240\u4EE5\u6211\u5C31\u5413\u574F\u4E86\uFF0C\u5F80\u5395\u6240\u8EB2\u2026\u2026"
      nextNodeId: 21
      options: []
    - nodeId: 21
      text: "\u5BF9\uFF0C\u8FD9\u4E2A\u65F6\u5019\u6211\u5728\u5395\u6240\u5077\u5077\u542C\u7740\uFF0C\u90A3\u8FB9\u597D\u50CF\u662F\u2026\u2026\u6709\u4EBA\u8FDB\u4E86\u6863\u6848\u5BA4\uFF1F\u53CD\u6B63\u6CA1\u6709\u811A\u6B65\u58F0\u4E86\uFF0C\u6240\u4EE5\u5C31\u76F4\u63A5\u51FA\u6765\u53BB\u4E86\u90E8\u957F\u7684\u529E\u516C\u5BA4\uFF0C\u7ED3\u679C\u4E00\u8FDB\u53BB\u5C31\u2026\u2026\u5C31\u2026\u2026\u53CD\u6B63\u6211\u6CA1\u6709\u6740\u4EBA\uFF01"
