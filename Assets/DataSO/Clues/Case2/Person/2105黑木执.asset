      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 9945e13ef5ad5dd4bbe572ff84430c7b, type: 2}
    dialogues:
    - nodeId: 7
      text: "\u4ECA\u665A\u4E94\u70B9\u591A\u7684\u65F6\u5019\u7684\u65F6\u5019\uFF0C\u6211\u770B\u7740\u96EA\u4E43\u5C0F\u59D0\u2026\u2026\u5979\u8FD8\u662F\u548C\u4E0B\u5348\u6F14\u51FA\u65F6\u4E00\u6837\uFF0C\u90A3\u4E48\u6194\u60B4\uFF0C\u90A3\u4E48\u695A\u695A\u52A8\u4EBA\uFF0C\u5C0F\u5FC3\u7FFC\u7FFC\u5730\u6253\u5F00\u6211\u9001\u7ED9\u5979\u7684\u793C\u7269\u7684\u8BF4\u2026\u2026"
      nextNodeId: 8
      options: []
    - nodeId: 8
      text: "\u90FD\u602A\u9AD8\u5CF0\u90A3\u8001\u6ED1\u5934\uFF0C\u80AF\u5B9A\u662F\u4ED6\u65E5\u65E5\u591C\u591C\u538B\u7740\u96EA\u4E43\u5C0F\u59D0\u5DE5\u4F5C\u7684\u8BF4\uFF01\u4E0D\u8FC7\u5C31\u7B97\u662F\u5982\u6B64\u75B2\u60EB\uFF0C\u96EA\u4E43\u5C0F\u59D0\u5BF9\u6211\u8FD8\u662F\u90A3\u4E48\u6E29\u67D4\u7684\u8BF4\u2026\u2026\u6BCF\u5929\u90FD\u6BD4\u524D\u4E00\u5929\u66F4\u559C\u6B22\u96EA\u4E43\u5C0F\u59D0\u4E00\u70B9\u7684\u8BF4\uFF01"
      nextNodeId: 
      options:
      - optionId: "\u60A8\u7684\u610F\u601D\u662F\uFF0C\u767D\u5DDD\u96EA\u4E43\u63A5\u89E6\u4E86\u70B9\u5FC3\uFF1F"
        optionText: "\u60A8\u7684\u610F\u601D\u662F\uFF0C\u767D\u5DDD\u96EA\u4E43\u63A5\u89E6\u4E86\u70B9\u5FC3\uFF1F"
