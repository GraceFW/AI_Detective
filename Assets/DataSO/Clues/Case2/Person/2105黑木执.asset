    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 95aacf91788fd0345a49903803720c6d, type: 2}
    dialogues:
    - nodeId: 4
      text: "\u5662\uFF0C\u96EA\u4E43\u5C0F\u59D0\u662F\u8FD9\u4E16\u4E0A\u6700\u7F8E\u597D\u7684\u5973\u5B69\u7684\u8BF4\uFF0C\u5979\u6709\u7740\u6700\u751C\u7F8E\u7684\u7B11\u5BB9\u548C\u6700\u5584\u826F\u7684\u7075\u9B42\u7684\u8BF4\u2026\u2026"
