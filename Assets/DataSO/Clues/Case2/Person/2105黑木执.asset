  - shownClue: {fileID: 11400000, guid: 9e49447758e645949a4d593c5718f82c, type: 2}
    dialogues:
    - nodeId: 5
      text: "\u4EC0\u4E48\uFF1F\u8FD9\u662F\u96EA\u4E43\u5C0F\u59D0\uFF0C\u8FD9\u4E2A\u7537\u4EBA\u662F\u8C01\uFF1F\u4ED6\u600E\u4E48\u80FD\u73B7\u6C61\u4E16\u4E0A\u6700\u7EAF\u6D01\u7684\u96EA\uFF01\u660E\u660E\u53EA\u6709\u6211\u2026\u2026\u53EA\u6709\u6211\u80FD\u62E5\u6709\u96EA\u4E43\u5C0F\u59D0\u7684\u8BF4\uFF01\u6211\u53EF\u662F\u5728\u7ED9\u96EA\u4E43\u5C0F\u59D0\u7684\u793C\u7269\u91CC\u653E\u4E86\u5FAE\u578B\u6444\u50CF\u5934\u7684\u8BF4\u2026\u2026\u6211\u60F3\u4E00\u76F4\u4E00\u76F4\u770B\u7740\u96EA\u4E43\u5C0F\u59D0\u7684\u8BF4\u2026\u2026"
      nextNodeId: 
      options:
      - optionId: "\u79C1\u81EA\u4F7F\u7528\u5FAE\u578B\u6444\u50CF\u5934\u662F\u72AF\u6CD5\u7684\u3002"
        optionText: "\u79C1\u81EA\u4F7F\u7528\u5FAE\u578B\u6444\u50CF\u5934\u662F\u72AF\u6CD5\u7684\u3002"
