  isAttackContentUnlocked: 0
  showAttackContentDirectly: 1
  attackUnlockContent: 
  summary: "\u672C\u95F4\u7EB8\u696D\uFF0C\u6210\u7ACB\u4E8E2042\u5E74\u3002\u4E3B\u8425\u4E1A\u52A1\u4E3A\u5BB6\u5EAD\u7528\u7EB8\u7684\u5236\u9020\u4E0E\u52A0\u5DE5\u3002\u957F\u671F\u4EE5OEM/ODM\uFF08\u8D34\u724C\u4EE3\u5DE5\uFF09\u4E3A\u4E3B\u8981\u4E1A\u52A1\u6A21\u5F0F\u3002\u4E3A\u591A\u5BB6\u77E5\u540D\u5546\u8D85\u54C1\u724C\u3001\u751F\u6D3B\u6742\u8D27\u54C1\u724C\u63D0\u4F9B\u4ECE\u4EA7\u54C1\u4F01\u5212\u5230\u91CF\u4EA7\u7684\u4E00\u7AD9\u5F0F\u670D\u52A1\u3002"
  detailText: 
  Detail_Mark: "[\u7ED3\u679C]\uFF1A\u547D\u4E2D\u8BB0\u5F55270\u6761\u3002\u6309\u5173\u8054\u5EA6\u4E0E\u53EF\u4FE1\u5EA6\u6392\u5E8F\u3002\r\n\r\n\u3010\u4F01\u4E1A\u6863\u6848\u3011\r\n\u6765\u6E90\uFF1A\u5168\u56FD\u9020\u7EB8\u4E1A\u8054\u5408\u4F1A\u4F1A\u5458\u540D\u5F55\u3001\u6CD5\u4EBA\u767B\u8BB0\u6570\u636E\u5E93\r\n\u5185\u5BB9\uFF1A\u672C\u95F4\u7EB8\u696D\u682A\u5F0F\u4F1A\u793E\uFF0C\u6210\u7ACB\u4E8E2042\u5E74\u3002\u672C\u793E\u4F4D\u4E8E\u9759\u5188\u53BF\u5BCC\u58EB\u5E02\u3002\u4E3B\u8425\u4E1A\u52A1\u4E3A\u5BB6\u5EAD\u7528\u7EB8\uFF08\u536B\u751F\u7EB8\u3001\u53A8\u623F\u7528\u7EB8\uFF09\u3001\u7EB8\u5DFE\u3001\u6E7F\u5DFE\u7684\u5236\u9020\u4E0E\u52A0\u5DE5\u3002\u8D44\u672C\u91D13\u4EBF\u65E5\u5143\uFF0C\u5458\u5DE5\u6570\u7EA6400\u4EBA\u3002\u62E5\u6709\u4E09\u6761\u5168\u81EA\u52A8\u751F\u4EA7\u7EBF\u53CA\u4E00\u5EA7\u7B26\u5408\u533B\u836F\u8F85\u52A9\u6750\u6599\u6807\u51C6\u7684\u8F66\u95F4\u3002\r\n\r\n\u3010\u5546\u4E1A\u6A21\u5F0F\u3011\r\n\u6765\u6E90\uFF1A\u65E5\u672C\u7D4C\u6E08\u65B0\u805E\u00B7\u5730\u65B9\u7248\u4E13\u8BBF\r\n\u5185\u5BB9\uFF1A\u672C\u95F4\u7EB8\u696D\u957F\u671F\u4EE5OEM/ODM\uFF08\u8D34\u724C\u4EE3\u5DE5\uFF09\u4E3A\u6838\u5FC3\u4E1A\u52A1\u6A21\u5F0F\u3002\u4E3A\u591A\u5BB6\u77E5\u540D\u5546\u8D85\u54C1\u724C\u3001\u751F\u6D3B\u6742\u8D27\u54C1\u724C\u63D0\u4F9B\u4ECE\u4EA7\u54C1\u4F01\u5212\u3001\u539F\u6599\u91C7\u8D2D\u5230\u91CF\u4EA7\u5305\u88C5\u7684\u4E00\u7AD9\u5F0F\u670D\u52A1\u3002\u5176\u4E0E\u512A\u54C1\u5802\u682A\u5F0F\u4F1A\u793E\u6709\u957F\u671F\u5408\u4F5C\u5173\u7CFB\uFF0C\u662F\u512A\u54C1\u5802\u65D7\u4E0B\u7EB8\u5DFE\u3001\u6E7F\u5DFE\u4EA7\u54C1\u7684\u4E3B\u8981\u4EE3\u5DE5\u5382\u3002\r\n\r\n\u3010\u8FD1\u671F\u52A8\u6001\u3011\r\n\u6765\u6E90\uFF1A\u9759\u5188\u53BF\u5546\u4E1A\u4FE1\u7528\u8C03\u67E5\u673A\u6784\u5185\u90E8\u62A5\u544A\r\n\u5185\u5BB9\uFF1A\u672C\u95F4\u7EB8\u696D\u8FD1\u4E24\u5E74\u9762\u4E34\u539F\u6599\u6210\u672C\u4E0A\u6DA8\u538B\u529B\uFF0C\u5229\u6DA6\u7387\u6709\u6240\u4E0B\u6ED1\u3002\u4E3A\u7EF4\u6301\u5927\u5BA2\u6237\u8BA2\u5355\uFF0C\u5728\u4EF7\u683C\u8C08\u5224\u4E2D\u5904\u4E8E\u76F8\u5BF9\u5F31\u52BF\u5730\u4F4D\u3002\r\n\r\n\u3010\u5173\u8054\u4F01\u4E1A\u3011\r\n\u6765\u6E90\uFF1A\u512A\u54C1\u5802\u91C7\u8D2D\u5F80\u6765\u8BB0\u5F55\uFF08\u53D7\u9650\u8BBF\u95EE\uFF09\r\n\u5185\u5BB9\uFF1A\u672C\u95F4\u7EB8\u696D\u4E0E\u512A\u54C1\u5802\u7684\u65E5\u5E38\u5BF9\u63A5\u7A97\u53E3\u4E3A\u9500\u552E\u4EE3\u8868\u82A5\u826F\u592B\u3002\u82A5\u826F\u592B\u8D1F\u8D23\u672C\u95F4\u7EB8\u696D\u5728\u512A\u54C1\u5802\u7684\u5168\u90E8\u4E1A\u52A1\uFF0C\u4E0E\u6B7B\u8005\u677E\u4E95\u77F3\u6839\u6709\u957F\u671F\u5DE5\u4F5C\u5F80\u6765\u3002\u8BB0\u5F55\u663E\u793A\uFF0C\u8FD1\u4E09\u4E2A\u6708\u53CC\u65B9\u6C9F\u901A\u9891\u7387\u663E\u8457\u589E\u52A0\uFF0C\u591A\u4E3A\u4EF7\u683C\u8C03\u6574\u53CA\u65B0\u5408\u540C\u6761\u6B3E\u78CB\u5546\u3002"
