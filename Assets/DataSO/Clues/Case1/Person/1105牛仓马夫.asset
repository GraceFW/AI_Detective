  - shownClue: {fileID: 11400000, guid: 1b1049098f6931c45969f49399b28c49, type: 2}
    dialogues:
    - nodeId: 12
      text: "\u51AC\u9A6C\u7ECF\u7406\uFF0C\u53EF\u6076\uFF0C\u8FD9\u5BB6\u4F19\u2026\u2026\u8FD9\u5BB6\u4F19\u770B\u7740\u4EBA\u6A21\u72D7\u6837\u7684\uFF0C\u5176\u5B9E\u5C31\u662F\u4E2A\u6DF7\u86CB\uFF0C\u603B\u662F\u628A\u81EA\u5DF1\u7684\u5DE5\u4F5C\u8BA9\u6211\u505A\uFF0C\u8FD8\u603B\u662F\u52FE\u642D\u6F02\u4EAE\u5C0F\u59D1\u5A18\uFF0C\u81EA\u5DF1\u4E00\u5927\u628A\u5E74\u7EAA\u4E86\u4E5F\u4E0D\u5BB3\u81CA\u2026\u2026\u53CD\u6B63\u3001\u53CD\u6B63\u4ED6\u4E0D\u662F\u4EC0\u4E48\u597D\u4EBA\uFF01\u4F60\u53EF\u5F97\u597D\u597D\u67E5\u67E5\u4ED6\u554A\uFF0C\u8B66\u5B98\uFF01"
