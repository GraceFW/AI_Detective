  - nodeId: 4
    text: "\u554A\uFF0C\u554A\u2026\u2026\u53EF\u6076\uFF0C\u4F46\u662F\uFF0C\u4F46\u662F\u6211\u6CA1\u6709\u6740\u4EBA\u2026\u2026\u6211\uFF0C\u6211\u2026\u2026\u6211\u53EA\u662F\u8FDB\u53BB\uFF0C\u7136\u540E\uFF0C\u7136\u540E\u53D1\u73B0\u90E8\u957F\u5012\u5728\u684C\u5B50\u4E0A\u2026\u2026\u6211\u8FC7\u53BB\u60F3\u770B\u770B\u8FD8\u6709\u6CA1\u6709\u6551\uFF0C\u7ED3\u679C\u4ED6\u5DF2\u7ECF\u6CA1\u6C14\u4E86\u2026\u2026"
    nextNodeId: 5
    options: []
  - nodeId: 5
    text: "\u6211\u3001\u6211\u770B\u5230\u684C\u5B50\u4E0A\u6709\u6211\u7684\u540D\u5B57\uFF0C\u6211\u6015\u88AB\u53D1\u73B0\u4E4B\u540E\u522B\u4EBA\u4EE5\u4E3A\u662F\u6211\u6740\u4E86\u4EBA\uFF0C\u6211\u5C31\u53BB\u6253\u6E7F\u4E86\u624B\u5E15\u60F3\u8981\u64E6\u6389\uFF0C\u7ED3\u679C\u624D\u64E6\u4E86\u64E6\u5C31\u542C\u5230\u7ECF\u7406\u8BF4\u5F00\u4F1A\u4E86\uFF0C\u6211\u2026\u2026\u6211\u5C31\u8D76\u7740\u53BB\u5F00\u4F1A\uFF0C\u6015\u4EBA\u591A\u4E86\u88AB\u770B\u5230\u2026\u2026\u5C31\u6CA1\u6709\u518D\u6CE8\u610F\uFF0C\u53EF\u662F\uFF0C\u53EF\u662F\u6211\u771F\u7684\u6CA1\u6740\u4EBA\u2026\u2026\u4F60\u770B\uFF0C\u8FD9\u662F\u6211\u7684\u624B\u5E15\u2026\u2026"
