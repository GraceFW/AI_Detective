      text: "\u6211\u6CA1\u89C1\u8FC7\u8FD9\u4E2A\u5305\u2026\u2026\u5636\uFF0C\u597D\u50CF\u53C8\u6709\u70B9\u773C\u719F\uFF0C\u4F46\u662F\u53CD\u6B63\u8FD9\u4E2A\u5305\u4E0D\u662F\u6211\u7684\u3002"
