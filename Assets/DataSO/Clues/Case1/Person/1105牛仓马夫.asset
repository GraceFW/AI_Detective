  - shownClue: {fileID: 11400000, guid: 95f7e7911c9e254408ef68d958d9b458, type: 2}
    dialogues:
    - nodeId: 6
      text: "\u5509\uFF0C\u5979\u6211\u8BA4\u8BC6\u7684\uFF0C\u662F\u677E\u4E95\u90E8\u957F\u7684\u59BB\u5B50\u2026\u2026\u4ECA\u5929\u665A\u4E0A\u5C31\u662F\u5979\u53D1\u73B0\u7684\u5C38\u4F53\u5427\uFF1F\u522B\u7684\u6211\u4E0D\u662F\u5F88\u719F\u6089\uFF0C\u5979\u4E4B\u524D\u6765\u7684\u5F88\u5C11\uFF0C\u5C31\u5728\u2026\u2026\u55EF\uFF0C\u524D\u5929\u5427\uFF0C\u6765\u8FC7\u516C\u53F8\u4E00\u6B21\u3002\u518D\u4E4B\u540E\u5C31\u662F\u4ECA\u5929\u4E86\u2026\u2026"
      nextNodeId: 7
      options: []
    - nodeId: 7
      text: "\u5979\u957F\u5F97\u8BA9\u6211\u5370\u8C61\u5F88\u6DF1\uFF0C\u6211\u8FD8\u4EE5\u4E3A\u662F\u516C\u53F8\u8C01\u7684\u5973\u670B\u53CB\u5462\u2026\u2026\u8FD8\u662F\u51AC\u9A6C\u7ECF\u7406\u4ECB\u7ECD\u6211\u4EEC\u8BA4\u8BC6\u2026\u2026"
