  - shownClue: {fileID: 11400000, guid: 95f7e7911c9e254408ef68d958d9b458, type: 2}
    dialogues:
    - nodeId: 4
      text: "\u65E9\u82D7\u554A\u2026\u2026\u65E9\u82D7\u771F\u662F\u4E2A\u53EF\u601C\u7684\u5973\u4EBA\uFF0C\u4ECE\u4E0A\u5B66\u7684\u65F6\u5019\u5C31\u662F\u2026\u2026\u6211\u4E5F\u6CA1\u6709\u60F3\u5230\u6700\u540E\u5979\u4F1A\u548C\u677E\u4E95\u5728\u4E00\u8D77\u3002"
