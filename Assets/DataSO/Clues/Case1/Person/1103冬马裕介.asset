  - shownClue: {fileID: 11400000, guid: e584e81da617f5246b0ed0b0e90d43b1, type: 2}
    dialogues:
    - nodeId: 8
      text: "\u90A3\u5BB6\u4F19\u554A\uFF0C\u5DE5\u4F5C\u633A\u52AA\u529B\u7684\uFF0C\u4E0D\u8FC7\u4EBA\u4E0D\u662F\u5F88\u806A\u660E\u3002\u4E4B\u524D\u5728\u5408\u540C\u4E0A\u72AF\u4E86\u4E2A\u5927\u9519\u8BEF\uFF0C\u5DEE\u70B9\u5F04\u51FA\u9634\u9633\u5408\u540C\u6765\uFF0C\u90A3\u53EF\u5C31\u662F\u5927\u4E8B\u4E86\uFF0C\u6574\u4E2A\u90E8\u95E8\u8981\u88AB\u67E5\u597D\u4E45\uFF0C\u8FD8\u597D\u6211\u53CD\u5E94\u5FEB\uFF0C\u5904\u7406\u53CA\u65F6\u3002\u8FD9\u5BB6\u4F19\u8FD8\u60F3\u628A\u4E8B\u60C5\u63A8\u5230\u90E8\u957F\u8EAB\u4E0A\uFF0C\u5207\uFF0C\u767D\u75F4\u3002"
