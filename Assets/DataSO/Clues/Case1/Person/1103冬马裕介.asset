  - shownClue: {fileID: 11400000, guid: 262e9d31b28c87f4b8fe18e06aa693ba, type: 2}
    dialogues:
    - nodeId: 10
      text: "\u82A5\u5148\u751F\uFF0C\u4ED6\u662F\u672C\u95F4\u7EB8\u696D\u7684\u9500\u552E\uFF0C\u548C\u677E\u4E95\u90E8\u957F\u4E5F\u8C08\u4E86\u51E0\u7B14\u5927\u5355\u5B50\u3002\u6211\u4E0D\u592A\u6E05\u695A\u4ED6\u662F\u6765\u505A\u4EC0\u4E48\u7684\uFF0C\u4E00\u822C\u4ED6\u6765\u90FD\u662F\u627E\u677E\u4E95\u90E8\u957F\uFF0C\u4ECA\u5929\u6211\u4EEC\u78B0\u5230\u7684\u65F6\u5019\uFF0C\u4ED6\u4E5F\u662F\u6253\u7B97\u8FDB\u677E\u4E95\u90E8\u957F\u7684\u529E\u516C\u5BA4\uFF0C\u53EA\u4E0D\u8FC7\u677E\u4E95\u90E8\u957F\u4F3C\u4E4E\u4E0D\u5728\uFF0C\u6CA1\u80FD\u8FDB\u53BB\u3002"
