  - shownClue: {fileID: 11400000, guid: 8b338377abe23e14d87780ff857ce5d7, type: 2}
    dialogues:
    - nodeId: 5
      text: "\u677E\u4E95\u90E8\u957F\u4E3A\u4EBA\u6BD4\u8F83\u4E25\u5389\uFF0C\u5E73\u65F6\u5BF9\u4E0B\u5C5E\u8BAD\u65A5\u7684\u5F88\u9891\u7E41\u3002\u4ED6\u4EE5\u524D\u5728\u4E0A\u5927\u5B66\u7684\u65F6\u5019\u8FD8\u4E0D\u81F3\u5982\u6B64\uFF0C\u81EA\u4ECE\u5750\u4E86\u529E\u516C\u5BA4\uFF0C\u662F\u8D8A\u53D1\u4E25\u91CD\u4E86\u3002"
      nextNodeId: 
      options:
      - optionId: "\u60A8\u548C\u6B7B\u8005\u592B\u59BB\u5F88\u719F\u6089\u5417\uFF1F"
