  - shownClue: {fileID: 11400000, guid: 95f7e7911c9e254408ef68d958d9b458, type: 2}
    dialogues:
    - nodeId: 4
      text: "\u65E9\u82D7\u554A\u2026\u2026\u65E9\u82D7\u771F\u662F\u4E2A\u53EF\u601C\u7684\u5973\u4EBA\uFF0C\u4ECE\u4E0A\u5B66\u7684\u65F6\u5019\u5C31\u662F\u2026\u2026\u660E\u660E\u662F\u4E2A\u5927\u7F8E\u5973\uFF0C\u5374\u770B\u4E0A\u4E86\u677E\u4E95\u77F3\u6839\u8FD9\u4E2A\u5BB6\u4F19\u3002\u8FD9\u5BB6\u4F19\u54EA\u70B9\u914D\u5F97\u4E0A\u65E9\u82D7\uFF1F\u8FD9\u4E0B\u4ED6\u6B7B\u4E86\uFF0C\u65E9\u82D7\u53C8\u8981\u4F24\u5FC3\u4E86\u3002"
