      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: e584e81da617f5246b0ed0b0e90d43b1, type: 2}
    dialogues:
    - nodeId: 7
      text: "\u725B\u4ED3\u5417\uFF1F\u4ED6\u662F\u677E\u4E95\u90E8\u957F\u624B\u4E0B\u7684\u7684\u4EBA\uFF0C\u5DE5\u4F5C\u633A\u52AA\u529B\u7684\uFF0C\u4E0D\u8FC7\u4EBA\u4E0D\u662F\u5F88\u806A\u660E\uFF0C\u4E4B\u524D\u4E5F\u72AF\u8FC7\u4E0D\u5C11\u9519\u5C31\u662F\u4E86\uFF0C\u5728\u4E0A\u4E2A\u6708\u768423\u53F7\u8FD8\u505A\u51FA\u4E86\u4E00\u4EFD\u9634\u9633\u5408\u540C\u6765\u3002"
      nextNodeId: 
      options:
      - optionId: "\u9634\u9633\u5408\u540C\uFF1F"
