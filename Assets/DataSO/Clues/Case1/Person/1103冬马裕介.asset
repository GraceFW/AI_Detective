        nextNodeId: 8
    - nodeId: 8
      text: "\u5728\u505A\u91C7\u8D2D\u9500\u552E\u8FD9\u4E00\u884C\uFF0C\u8FD8\u662F\u86EE\u5E38\u89C1\u7684\u2014\u2014\u4EE5\u516C\u53F8\u540D\u4E49\u8FDB\u884C\u91C7\u8D2D\uFF0C\u5E76\u9AD8\u4EF7\u5408\u540C\u6210\u4EA4\uFF0C\u800C\u5B9E\u9645\u4E0A\u771F\u7684\u82B1\u5728\u91C7\u8D2D\u4E0A\u7684\u8D39\u7528\u6CA1\u90A3\u4E48\u9AD8\uFF0C\u591A\u51FA\u6765\u7684\u4EF7\u683C\u5C31\u81EA\u5DF1\u541E\u6389\u3002"
      nextNodeId: 9
      options: []
    - nodeId: 9
      text: "\u4F46\u662F\u6211\u4E0D\u8BA4\u4E3A\u4ED6\u81EA\u5DF1\u4F1A\u6709\u8FD9\u4E2A\u80C6\u5B50\u3002\u6216\u8BB8\u8FD9\u662F\u677E\u4E95\u90E8\u957F\u7684\u6388\u610F\u5427\u2014\u2014\u4ED6\u4E00\u76F4\u7ED9\u725B\u4ED3\u5F88\u5927\u7684\u538B\u529B\uFF0C\u5373\u4FBF\u4E0B\u8FD9\u79CD\u547D\u4EE4\uFF0C\u60F3\u5FC5\u725B\u4ED3\u4E5F\u4E0D\u5F97\u4E0D\u53BB\u505A\u3002"
      nextNodeId: 
      options: []
    singleUse: 0
  - shownClue: {fileID: 11400000, guid: 262e9d31b28c87f4b8fe18e06aa693ba, type: 2}
    dialogues:
    - nodeId: 10
      text: "\u82A5\u5148\u751F\uFF0C\u4ED6\u662F\u672C\u95F4\u7EB8\u696D\u7684\u9500\u552E\uFF0C\u548C\u677E\u4E95\u90E8\u957F\u4E5F\u8C08\u4E86\u51E0\u7B14\u5927\u5355\u5B50\u3002\u4E00\u822C\u4ED6\u6765\u90FD\u662F\u627E\u677E\u4E95\u90E8\u957F\uFF0C\u4ECA\u5929\u6211\u4EEC\u78B0\u5230\u7684\u65F6\u5019\uFF0C\u4ED6\u4E5F\u662F\u6253\u7B97\u8FDB\u677E\u4E95\u90E8\u957F\u7684\u529E\u516C\u5BA4\uFF0C\u53EA\u4E0D\u8FC7\u677E\u4E95\u90E8\u957F\u4F3C\u4E4E\u4E0D\u5728\uFF0C\u6CA1\u80FD\u8FDB\u53BB\u3002"
