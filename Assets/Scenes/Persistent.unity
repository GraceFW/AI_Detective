    - speakerName: "\uFF1F\uFF1F\uFF1F"
      speakerImage: {fileID: 0}
      dialogueText: "\u4E0D\u8FC7\u4E5F\u8FD8\u7B97\u5C3D\u5174\u2014\u2014\u4F60\u6BD4\u90A3\u4E9B\u7F51\u8B66\u6709\u610F\u601D\u591A\u4E86\u3002"
