    - speakerName: "\uFF1F\uFF1F\uFF1F"
      speakerImage: {fileID: 0}
      dialogueText: "\u4E0D\u8FC7\uFF0C\u4F60\u8BF4\u5F97\u5BF9\uFF0C\u8FD9\u4E2A\u65F6\u4EE3\u65E9\u5DF2\u6CA1\u6709\u4FA6\u63A2\u4E86\u3002"
