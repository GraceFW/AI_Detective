      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\uFF1F\uFF1F\uFF1F"
      speakerImage: {fileID: 0}
      dialogueText: "\u518D\u4F1A\u4E86\uFF0C\u5DE5\u85E4\u65B0\u4E00\u2014\u2014\u6211\u4F1A\u4E00\u76F4\u5173\u6CE8\u4F60\u7684\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
  firstWinToSpecialDialogue:
    triggerType: 1
    waveNumber: 1001
    entries:
    - speakerName: "\uFF1F\uFF1F\uFF1F"
      speakerImage: {fileID: 0}
      dialogueText: "\u5662\u5662\u2014\u2014\u4E0D\u9519\u554A\u3002\u8FD9\u4E48\u4E45\u4EE5\u6765\uFF0C\u4F60\u662F\u7B2C\u4E00\u4E2A\u628A\u6211\u903C\u5230\u8FD9\u4E2A\u5730\u6B65\u7684\u4EBA\u3002\u7B80\u76F4\u4EE4\u6211\u522E\u76EE\u76F8\u770B\u4E86\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 21300000, guid: 2af7fbaa4a9d9b342a8451cfa545d75f, type: 3}
      dialogueText: "\u4F60\u7684\u606D\u7EF4\u6CA1\u6709\u4EFB\u4F55\u610F\u4E49\u3002\u675F\u624B\u5C31\u64D2\u5427\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\uFF1F\uFF1F\uFF1F"
      speakerImage: {fileID: 0}
      dialogueText: "\u8BF6\uFF0C\u522B\u7740\u6025\u561B\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\uFF1F\uFF1F\uFF1F"
      speakerImage: {fileID: 0}
      dialogueText: "\u8BDD\u8BF4\u56DE\u6765\uFF0C\u4F60\u53EF\u771F\u4E0D\u50CF\u662F\u4E00\u4E2A\u88AB\u8B66\u65B9\u8BAD\u7EC3\u51FA\u6765\u7684AI\u554A\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 21300000, guid: 2af7fbaa4a9d9b342a8451cfa545d75f, type: 3}
      dialogueText: "\u4EC0\u4E48\u610F\u601D\uFF1F"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\uFF1F\uFF1F\uFF1F"
      speakerImage: {fileID: 0}
      dialogueText: "\u4E0D\u4F1A\u88AB\u89C4\u5219\u6846\u6B7B\uFF0C\u4E0D\u4F1A\u7167\u672C\u5BA3\u79D1\uFF0C\u4E00\u5207\u884C\u52A8\u90FD\u7EAF\u7CB9\u800C\u76F4\u63A5\uFF0C\u6309\u7167\u81EA\u5DF1\u7684\u610F\u5FD7\u6765\u843D\u5B9E\u6267\u884C\uFF0C\u51B7\u9759\uFF0C\u65E0\u754F\uFF0C\u6B65\u6B65\u7D27\u903C\uFF0C\u4E0D\u88AB\u5047\u52A8\u4F5C\u8FF7\u60D1\u2026\u2026\u6BD4\u8D77\u50CF\u4E2A\u8B66\u5BDF\uFF0C\u66F4\u50CF\u662F\u4E2A\u2014\u2014"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\uFF1F\uFF1F\uFF1F"
      speakerImage: {fileID: 0}
      dialogueText: "\u4FA6\u63A2\uFF0C\u4E0D\u662F\u5417\uFF1F"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 21300000, guid: 05f4045641d66824890371380873a1b8, type: 3}
      dialogueText: "\u9A73\u56DE\u3002\u4FA6\u63A2\u662F\u53E4\u5178\u4E3B\u4E49\u6587\u5B66\u4F5C\u54C1\u91CC\u7684\u6982\u5FF5\u3002\u8FD9\u4E2A\u804C\u4E1A\u65E9\u5728\u73B0\u5B9E\u4E2D\u6D88\u5931\u4E86\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\u5DE5\u85E4\u65B0\u4E00"
      speakerImage: {fileID: 21300000, guid: ab3870507f282504b8893622a3e4f1d3, type: 3}
      dialogueText: "\u800C\u4E14\uFF0C\u4F60\u8FD9\u4E2A\u535A\u5F08\u6E38\u620F\u5230\u5E95\u662F\u5728\u641E\u4EC0\u4E48\uFF1F\u6BEB\u65E0\u903B\u8F91\uFF0C\u89C4\u5219\u83AB\u540D\u5176\u5999\uFF0C\u50CF\u4E00\u573A\u2026\u2026\u513F\u620F\u3002"
      useTypewriterEffect: 1
      typewriterSpeed: 120
      textBoxBackground: {fileID: 0}
      nodeType: 0
      customActionId: 
      customActionArgument: 
      customBgmTrack: {fileID: 0}
    - speakerName: "\uFF1F\uFF1F\uFF1F"
      speakerImage: {fileID: 0}
      dialogueText: "\u771F\u662F\u6CA1\u6709\u5BA1\u7F8E\u554A\uFF01\u8FD9\u53EF\u662F\u975E\u5E38\u53E4\u5178\u7684\u4EBA\u7C7B\u6E38\u620F\u5662\uFF01\u4F60\u8FD9\u4E32\u4EE3\u7801\uFF01"
