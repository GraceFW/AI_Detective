  tooltipBodyText: {fileID: 2358834889695378808}
  tooltipAutoSize: {fileID: 926781013452535039}
  actionTooltipContents:
  - actionType: 1
    content:
      title: "\u63A8\u7406\uFF1A"
      body: "\u901A\u8FC7\u73B0\u573A\u89C2\u5BDF\u548C\u903B\u8F91\u5206\u6790\uFF0C\u6536\u96C6\u7834\u6848\u7EBF\u7D22\u3002\u3010\u53EF\u79EF\u7D2F1\u70B9\u80FD\u91CF\u3002\u3011"
      actionTitle: "\u63A8\u7406"
      actionText: "\u53EF\u79EF\u7D2F1\u70B9\u80FD\u91CF"
  - actionType: 2
    content:
      title: "\u8B66\u6212\uFF1A"
      body: "\u63D0\u9AD8\u8B66\u60D5\uFF0C\u9632\u8303\u7A81\u7136\u88AD\u51FB\u3002\u3010\u53EF\u62B5\u6321\u4E00\u6B21\u620F\u5F04\u6216\u9003\u8131\u3002\u4E00\u56DE\u5408\u53EA\u80FD\u4F7F\u7528\u4E00\u6B21\u3002\u3011"
      actionTitle: "\u8B66\u6212"
      actionText: "\u53EF\u62B5\u6321\u4E00\u6B21\u620F\u5F04\u6216\u9003\u8131\u3002\u4E00\u56DE\u5408\u53EA\u80FD\u4F7F\u7528\u4E00\u6B21"
  - actionType: 3
    content:
      title: "\u8FFD\u51FB\uFF1A"
      body: "\u6839\u636E\u5DF2\u6709\u7EBF\u7D22\u5C55\u5F00\u8FFD\u51FB\u3002\u3010\u6D88\u80171\u80FD\u91CF\uFF0C\u9020\u62101\u70B9\u4F24\u5BB3\u3002\u3011"
      actionTitle: "\u8FFD\u51FB"
      actionText: "\u6D88\u80171\u80FD\u91CF\uFF0C\u9020\u62101\u70B9\u4F24\u5BB3"
  - actionType: 4
    content:
      title: "\u902E\u6355\uFF1A"
      body: "\u96C6\u9F50\u6240\u6709\u51B3\u5B9A\u6027\u8BC1\u636E\uFF0C\u8FDB\u884C\u4E00\u4E3E\u51FB\u7834\u3002\u3010\u6D88\u80173\u80FD\u91CF\uFF0C\u9020\u62103\u70B9\u4F24\u5BB3\u3002\u3011"
      actionTitle: "\u902E\u6355"
      actionText: "\u6D88\u80173\u80FD\u91CF\uFF0C\u9020\u62103\u70B9\u4F24\u5BB3"
  aiActionTooltipContents:
  - actionType: 1
    content:
      title: "\u8BE1\u8BA1\uFF1A"
      body: "\u6697\u4E2D\u5E03\u7F6E\uFF0C\u4E3A\u9003\u8131\u505A\u51C6\u5907\u3002\u3010\u53EF\u79EF\u7D2F1\u70B9\u80FD\u91CF\u3002\u3011"
      actionTitle: "\u8BE1\u8BA1"
      actionText: "\u53EF\u79EF\u7D2F1\u70B9\u80FD\u91CF"
  - actionType: 2
    content:
      title: "\u9690\u533F\uFF1A"
      body: "\u9690\u85CF\u81EA\u5DF1\uFF0C\u8EB2\u907F\u8FFD\u6355\u3002\u3010\u53EF\u62B5\u6321\u4E00\u6B21\u8FFD\u51FB\u6216\u902E\u6355\u3002\u4E00\u56DE\u5408\u53EA\u80FD\u4F7F\u7528\u4E00\u6B21\u3002\u3011"
      actionTitle: "\u9690\u533F"
      actionText: "\u53EF\u62B5\u6321\u4E00\u6B21\u8FFD\u51FB\u6216\u902E\u6355\u3002\u4E00\u56DE\u5408\u53EA\u80FD\u4F7F\u7528\u4E00\u6B21"
  - actionType: 3
    content:
      title: "\u620F\u5F04\uFF1A"
      body: "\u5E72\u6270\u5BF9\u624B\uFF0C\u4F7F\u5176\u884C\u52A8\u53D7\u632B\u3002\u3010\u6D88\u80171\u80FD\u91CF\uFF0C\u9020\u62101\u70B9\u4F24\u5BB3\u3002\u3011"
      actionTitle: "\u620F\u5F04"
      actionText: "\u6D88\u80171\u80FD\u91CF\uFF0C\u9020\u62101\u70B9\u4F24\u5BB3"
  - actionType: 4
    content:
      title: "\u9003\u8131\uFF1A"
      body: "\u5F7B\u5E95\u6D88\u5931\uFF0C\u9003\u8131\u8FFD\u6355\u3002\u3010\u6D88\u80173\u80FD\u91CF\uFF0C\u9020\u62103\u70B9\u4F24\u5BB3\u3002\u3011"
      actionTitle: "\u9003\u8131"
      actionText: "\u6D88\u80173\u80FD\u91CF\uFF0C\u9020\u62103\u70B9\u4F24\u5BB3"
